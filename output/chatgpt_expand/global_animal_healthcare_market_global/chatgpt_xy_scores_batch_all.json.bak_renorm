{
  "industry_group": "Healthcare",
  "industry_category": "Pharmaceutical",
  "axis_x": "Product Strength",
  "axis_y": "Business Strategy",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the dual nature of animal health: product innovation and manufacturing excellence (X) combined with commercial scale and strategic growth (Y), tailored to the specific needs of veterinary medicine and livestock production.",
  "parameter_definitions": {
    "x": {
      "Vaccine & Biologic Portfolio": "Breadth and depth of vaccines and biologicals for major species (companion, livestock, poultry). Strength shown by number of licensed products, novel antigen platforms, and market share in core segments.",
      "Parasiticide & Anti-Infective Coverage": "Range of products for parasites, bacteria, fungi, and viruses across species. Strength indicated by spectrum of activity, convenience of formulations, and resistance management strategies.",
      "Diagnostics & Digital Health Integration": "Investment in diagnostic tools (e.g., point-of-care tests, imaging) and digital platforms (e.g., telemedicine, data analytics) that enhance disease detection and treatment monitoring. Strength evidenced by product launches, partnerships, and adoption rates.",
      "Manufacturing Capacity & Supply Chain": "Ability to produce high-quality products at scale with reliable supply. Strength shown by number of facilities, capacity utilization, redundancy, and track record of supply continuity.",
      "Regulatory Approvals & Compliance": "Portfolio of approvals from major agencies (FDA, EMA, etc.) and compliance with GMP and pharmacovigilance standards. Strength indicated by recent approvals, inspection history, and global registration footprint."
    },
    "y": {
      "Global Market Penetration": "Presence and sales across key geographies (North America, Europe, Asia-Pacific, etc.). Strength shown by revenue distribution, market share in major countries, and entry into emerging markets.",
      "Veterinarian & Producer Trust": "Reputation among veterinarians and livestock producers based on product efficacy, safety, and support services. Strength evidenced by brand loyalty, prescription rates, and industry surveys.",
      "Revenue & Profitability": "Financial performance including total revenue, growth rate, and margins. Strength indicated by consistent revenue growth, profitability ratios, and investment in R&D.",
      "Pipeline & Label Expansion": "Number and stage of products in development, as well as efforts to expand labels for existing products (new species, indications). Strength shown by pipeline size, phase advancement, and recent label extensions.",
      "Strategic Alliances & M&A": "Partnerships, licensing deals, and acquisitions that enhance product portfolio, technology access, or market reach. Strength indicated by number and value of deals, and their strategic fit."
    }
  },
  "x_features": [
    "Vaccine & Biologic Portfolio",
    "Parasiticide & Anti-Infective Coverage",
    "Diagnostics & Digital Health Integration",
    "Manufacturing Capacity & Supply Chain",
    "Regulatory Approvals & Compliance"
  ],
  "y_features": [
    "Global Market Penetration",
    "Veterinarian & Producer Trust",
    "Revenue & Profitability",
    "Pipeline & Label Expansion",
    "Strategic Alliances & M&A"
  ],
  "x_feature_weights": [
    0.3,
    0.2,
    0.2,
    0.15,
    0.15
  ],
  "y_feature_weights": [
    0.25,
