  "parameter_definitions": {
    "x": {
      "Process / Node & Technology Leadership": "Leadership in process technology nodes (e.g., 3nm, 5nm) and advanced packaging (e.g., chiplets, 3D stacking). Evidence includes public announcements of node adoption, foundry partnerships, and technology roadmaps.",
      "Product Portfolio Breadth (logic, memory, analog, power, OSAT)": "Breadth of product categories covering logic, memory, analog, power, and OSAT services. Evidence includes product line diversity, market share across segments, and revenue mix.",
      "Design IP & Architecture Strength": "Strength of proprietary design IP, architectures, and EDA tools. Evidence includes patent portfolio, licensing revenue, and adoption of proprietary cores or architectures.",
      "Manufacturing Capacity, Yield & Packaging": "Manufacturing capacity, yield rates, and advanced packaging capabilities. Evidence includes fab capacity, utilization rates, yield improvements, and packaging technology offerings.",
      "Quality, Reliability & Compliance": "Quality and reliability standards, certifications (e.g., ISO, AEC-Q100), and compliance with regulations. Evidence includes defect rates, customer returns, and certifications."
    },
    "y": {
      "Geographic & End-Market Reach": "Geographic presence and penetration across key end-markets (e.g., automotive, consumer, industrial). Evidence includes revenue by region, customer base, and market share in target segments.",
      "Customer / Ecosystem Partnerships": "Strength of partnerships with customers, suppliers, and ecosystem players (e.g., OEMs, OSATs, EDA vendors). Evidence includes long-term agreements, joint development programs, and ecosystem alliances.",
      "Financial Strength & CapEx Capacity": "Financial health and ability to invest in R&D and capital expenditures. Evidence includes revenue growth, profitability, cash flow, and CapEx spending.",
      "Technology & Product Roadmap": "Clarity and credibility of future technology and product roadmap. Evidence includes public roadmap disclosures, R&D investment, and planned product launches.",
      "Capacity Expansion & Business Growth": "Plans and execution for capacity expansion and business growth. Evidence includes new fab announcements, capacity additions, and revenue growth trajectory."
    }
  },
