al Presence": "Germany", "Ownership": "Not publicly disclosed", "Employees": "Not publicly disclosed", "Core Categories": "Not publicly disclosed", "Specialty Focus": "SUSS MicroTec is a German manufacturer of equipment for photomask processing, wafer bonding, and lithography, serving the semiconductor industry.", "Key Brands Represented": "Not publicly disclosed", "Retail / E-commerce / Both": "No", "Distribution Type": "Solution Provider", "Contact Person": "", "Role": "", "Email": "", "LinkedIn": "", "Office No.": "", "Country Code": "DE", "Region Code": "EU", "Summary": "SUSS MicroTec SE — channel participant (openai_web_search_discover). Verify: Manufactures equipment for photomask processing, wafer bonding, and lithography.", "Data Sources": "google_ai", "Data Confidence": "Medium", "Quality Score": "3", "commercial_role": "Solution Provider", "verify_confidence": "95", "_evidence_snapshot": {"source": "", "domain": "suss.com", "data": {"company": {"name": "suss.com"}, "business": {"products": [], "services": []}, "intel": {"summary": "[ ][1]\nFor Investors\n* [Investor Relations ][2]\n* [Share ][3]\n* [Financial Events, Conferences & Roadshows ][4]\n* [Corporate Governance ][5]\n* [Annual General Meeting ][6]\n* [Financial Reports ][7]\n* [Company Announcements & Regulatory Disclosures ][8]\n* [Contact ][9]\nNewsroom\n* [Latest News & Events ][10]\n* [Media Library ][11]\nEN\nEnglish [Deutsch][12] [日本語][13] [简体中文][14] [繁體中文][15] [한국어][16]\n[ ][17]\n* Products / Solutions\n  [\n  Explore our solutions\n  \n  Our systems and process solutions across imaging, coating, bonding, and photomask applications.\n  \n  ][18]\n  * [ Portfolio overview ][19]\n  * Photomask Solutions\n    * [Cleaning ][20]\n    * [Bake & Develop ][21]\n  * Coating Solutions\n    * [Inkjet Printing ][22]\n    * [Coating & Developing ][23]\n  * Imaging Solutions\n    * [UV Scanning ][24]\n    * [Mask Alignment ][25]\n  * Bonding Solutions\n    * [Permanent Bonding ][26]\n    * [Temporary Bon