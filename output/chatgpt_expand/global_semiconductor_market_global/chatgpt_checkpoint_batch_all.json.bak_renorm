oodman Scholarship", "category": "Scholarship", "features": ["Awards to students", "Over $935,000 awarded since 2008"], "pricing": null}, {"name": "Events & Ag Expos", "category": "Events", "features": ["Iowa Ag Expo", "Nebraska Ag Expo", "Career Exploration Events", "Nebraska Innovation After Hours", "Fall Board Meeting"], "pricing": null}, {"name": "Dealer Membership", "category": "Membership", "features": ["Powerful network of dealers and industry partners", "Representation, resources, and support"], "pricing": null}, {"name": "Associate Membership", "category": "Membership", "features": ["For industry partners"], "pricing": null}], "industries": ["Agriculture", "Construction", "Outdoor Power Equipment"], "key_markets": ["Iowa", "Nebraska"]}, "financials": {"key_numbers": ["Over 132 years old", "$4.5B combined gross annual sales of equipment & service by Iowa and Nebraska equipment dealers", "9,000 personnel employed by equipment dealers in sales, management, parts, service, accounting, HR, marketing, workforce development", "90% of dealership jobs are in communities with population less than 10,000", "428 dealer member locations in Iowa and Nebraska", "Over $935,000 awarded to more than 796 students through scholarship program since 2008"], "employee_count": null}, "relationships": {"customers": [], "investors": []}, "intel": "INEDA is a long-established (over 132 years) nonprofit trade association representing ~428 agriculture, construction, and outdoor power equipment dealer locations across Iowa and Nebraska. Its value proposition centers on legislative advocacy, workforce development, education/training, and regulatory compliance. Key impact metrics include $4.5B in combined dealer sales, 9,000 dealer-employed personnel, and $935K+ in scholarships awarded since 2008. The organization positions itself as a community pillar for rural dealerships, with 90% of dealership jobs in towns under 10,000 population. The site emphasizes membership, events (Iowa Ag Expo, Nebraska Ag Expo), and publications as engagement channels.", "location": {"offices": ["8330 NW 54th Ave, Johnston, IA, 50131"], "countries": [], "regions_served": ["Iowa", "Nebraska"]}, "media": {"articles": [], "press_releases": [], "investor_presentations": []}}, "page_text": "", "discovery_snippets": [], "classify": {"summary": "Ineda Systems — channel participant (openai_web_search_discover). Verify: Fabless semiconductor company designing low-power SoCs, builds/owns technology. | Fabless semiconductor company designing low-power SoCs for wearables and IoT. | India | India", "role_description": "Solution Provider"}}, "X Score": "62", "Y Score": "57", "Overall Score": "60", "Industry Category": "ICT, Automation, Semiconductor / Semiconductors", "Quadrant": "Trailblazers"}, {"Company": "Redlen Technologies", "Website": "https://redlen.com", "Founded": "Not publicly disclosed", "Headquarters": "Canada", "Continent / Geography": "NA(Canada)", "Operational Presence": "Canada", "Ownership": "Not publicly disclosed", "Employees": "Not publicly disclosed", "Core Categories": "Not publicly disclosed", "Specialty Focus": "Produces CZT-based semiconductor detectors for medical imaging and security applications.", "Key Brands Represented": "Not publicly disclosed", "Retail / E-commerce / Both": "No", "Distribution Type": "Solution Provider", "Contact Person": "", "Role": "", "Email": "", "LinkedIn": "", "Office No.": "", "Country Code": "CA", "Region Code": "NA", "Summary": "Redlen Technologies — channel participant (openai_web_search_discover). Verify: Produces CZT-based semiconductor detectors, building their own semiconductor devices.", "Data Sources": "google_ai", "Data Confidence": "Medium", "Quality Score": "3", "commercial_role": "Solution Provider", "verify_confidence": "90", "_evidence_snapshot": {"source": "", "domain": "redlen.com", "data": {"company": {"name": "redlen.com"}, "business": {"products": [], "services": []}, "intel": {"summary": "top of page\n[\n][