dia", "Website": "https://www.intel.in", "Founded": "Not publicly disclosed", "Headquarters": "India", "Continent / Geography": "APAC(India)", "Operational Presence": "India", "Ownership": "Not publicly disclosed", "Employees": "Not publicly disclosed", "Core Categories": "Not publicly disclosed", "Specialty Focus": "Intel India is a major R&D hub for Intel, involved in design, validation, and software development for processors and other semiconductor products.", "Key Brands Represented": "Not publicly disclosed", "Retail / E-commerce / Both": "No", "Distribution Type": "Solution Provider", "Contact Person": "", "Role": "", "Email": "", "LinkedIn": "", "Office No.": "", "Country Code": "IN", "Region Code": "APAC", "Summary": "Intel India — channel participant (openai_web_search_discover). Verify: Intel is a major chipmaker; India operations are part of Intel's design and development.", "Data Sources": "google_ai", "Data Confidence": "Medium", "Quality Score": "3", "commercial_role": "Solution Provider", "verify_confidence": "95", "_evidence_snapshot": {"source": "", "domain": "intel.in", "data": {"company": {"name": "intel.in"}, "business": {"products": [], "services": []}, "intel": {"summary": "[ Skip To Main Content ][1]\nToggle Navigation\n1. Products\n   [ Products Home ][2]\n   [ Processors ][3]\n   * [ Intel® Core™ Ultra Processors ][4]\n   * [ Intel® Core™ Processors ][5]\n   * [ Intel® Xeon® Processors ][6]\n   * [ Intel® Xeon® CPU Max Series ][7]\n   * [ Intel® Arc™ G-Series Processors ][8]\n   * [ Intel Atom® Processors ][9]\n   [ Select Systems & Devices ][10]\n   * [ AI PCs Powered by Intel ][11]\n   * [ Gaming Systems ][12]\n   * [ Intel vPro® for Business ][13]\n   * [ Intel® Arc™ Graphics ][14]\n   * [ Intel® Wi-Fi Products ][15]\n   [ AI Accelerators ][16]\n   * [ Intel® Gaudi® AI Accelerators ][17]\n   * [ Intel® Data Center GPU Flex Series ][18]\n   [ Network to Edge ][19]\n   * [ Edge and Embedded Processors ][20]\n   * [ Intel® Ethernet Products