)", "_source": "user_400_v2_list", "ownership": "Independent", "ownership_confidence": "low"}], "rejected_mid": [{"name": "Alphageo (India) Limited", "reason": "Operates strictly as an onshore integrated seismic service provider; its dedicated marine and offshore subsidiaries currently hold no commercial operations.", "confidence": "high"}, {"name": "Searcher Seismic Pty Ltd", "reason": "A multi-client data library and data vendor company that licenses seismic datasets but outsources the actual execution of data processing and reprocessing workflows to third-party geophysical contractors.", "confidence": "high"}, {"name": "SeaBird Exploration PLC", "reason": "Primarily a marine seismic data acquisition contractor; its data processing is limited to onboard quality control (QC) and initial conditioning rather than standalone advanced processing services.", "confidence": "high"}, {"name": "Electromagnetic Geoservices ASA", "reason": "Primary business is providing marine Controlled-Source Electromagnetic (CSEM) and magnetotelluric (MT) survey data and inversion services, rather than executing traditional marine seismic data processing services on client data.", "confidence": "high"}, {"name": "DECO Geophysical SC", "reason": "Primarily a geophysical software company developing the RadExPro platform. Its specialized service offerings target high-resolution near-surface geotechnical, engineering, and environmental imaging, not the defined deep hydrocarbon exploration market.", "confidence": "high"}, {"name": "Petrosys Pty Ltd", "reason": "Mainly develops and licenses subsurface mapping, surface modeling, and seismic data processing software (such as Claritas and Petrosys PRO) rather than executing processing services for clients.", "confidence": "high"}, {"name": "Stryde Limited", "reason": "Primarily a land-based nodal seismic technology manufacturer and onshore processing provider; does not offer marine or offshore seismic data processing services.", "confidence": "high"}, {"name": "Geodevice LLC", "reason": "Primarily a designer, manufacturer, and supplier of geophysical hardware and marine seismic equipment, as well as a software vendor; it does not operate primarily as a commercial processing service provider.", "confidence": "high"}, {"name": "PXGEO", "reason": "A marine seismic acquisition specialist focused on towed streamer and ocean bottom node (OBN) data collection; it outsources final full-cycle processing and imaging to external vendors.", "confidence": "high"}, {"name": "Polaris Seismic International Ltd.", "reason": "Specializes strictly in onshore (land) and transition zone seismic acquisition and processing solutions; does not operate in the deep-water marine processing market.", "confidence": "high"}, {"name": "Choice Geophysical Services Limited", "reason": "Official UK Companies House records indicate that this entity is dissolved, making it an inactive player that does not currently provide commercial services in the market.", "confidence": "high"}, {"name": "Deep Ocean Marine Engineering L.L.C.", "reason": "The company is a specialized marine engineering, ship management, and offshore technical solutions provider; it does not offer or execute marine seismic data processing services.", "confidence": "high"}, {"name": "Oceania Geo Pty Ltd", "reason": "The company provides seismic survey design, acquisition, and processing services exclusively for onshore/land applications (e.g., using land-based nodal receivers, weight drops, and dynamite) rather than marine or offshore datasets.", "confidence": "high"}, {"name": "Compañía Mexicana de Exploraciones, S.A. de C.V.", "reason": "Although historically a geophysical service provider for Pemex, the company was officially dissolved and entered liquidation proceedings in July 2024, rendering it no longer an active commercial service provider.", "confidence": "high"}, {"name": "Sterling Seismic Services", "reason": "The company focuses its commercial processing services on surface land seismic data across US basins and borehole/VSP datasets rather than marine (offshore) surface seismic datasets.", "confidence": "high"}, {"name": "Geo Marine Survey Systems", "reason": "The company's primary commercial business model is focused on the production, supply, manufacturing, and rental of ultra-high-resolution marine seismic equipment (such as sparkers, streamers, and winches). While they offer advanced seismic processing and interpretation, they state that these services are executed via an external partnership with GeoSurveys (Portugal) rather than being performed directly as their own stand-alone commercial service offering.", "confidence": "high"}, {"name": "Headwaters Seismic Processing Inc.", "reason": "Operates as a processing service provider but explicitly specializes in land/onshore seismic data processing rather than marine/offshore datasets.", "confidence": "high"}, {"name": "SAExploration Holdings Inc.", "reason": "Primarily focused on seismic data acquisition and logistics rather than standalone commercial seismic processing services.", "confidence": "high"}, {"name": "Star Geophysics, Inc.", "reason": "While it operates as a seismic data processing service provider, its verified operations and commercial capabilities focus exclusively on onshore/land seismic data processing within US basins, with no verifiable commercial offerings for marine offshore datasets.", "confidence": "high"}, {"name": "...", "reason": "no verdict returned", "confidence": "low"}, {"name": "Ikon Science Limited", "reason": "Primarily a standalone software vendor specializing in geo-prediction, rock physics, and reservoir characterization software (e.g., RokDoc) rather than offering commercial marine seismic data processing services.", "confidence": "high"}, {"name": "Earth Science Analytics AS", "reason": "Primarily a cloud-native software provider that develops and licenses the EarthNET AI-driven geoscience platform rather than executing traditional processing services on client data.", "confidence": "high"}, {"name": "Sharp Reflections GmbH", "reason": "Primary business is providing big data software platforms (formerly PreStack Pro) for seismic data interpretation and analysis rather than acting as a processing service bureau.", "confidence": "high"}, {"name": "PXGEO Seismic Services LLC", "reason": "Operates as a marine geophysical service provider focusing strictly on offshore seismic data acquisition (OBN and towed streamer) and passes data to specialized partners for full processing and imaging workflows.", "confidence": "high"}, {"name": "Syntillica Limited", "reason": "An independent energy consultancy group providing survey design, advisory, and processing quality control (QC) services rather than executing the actual seismic data processing themselves.", "confidence": "high"}, {"name": "InApril AS", "reason": "InApril is a supplier of seabed seismic technology, ocean bottom nodes (OBN), and automated node handling systems rather than executing data processing services for clients.", "confidence": "high"}, {"name": "Geonet Ltd", "reason": "no verdict returned", "confidence": "low"}, {"name": "PXGEO Seismic Services Ltd", "reason": "PXGEO is primarily a marine geophysical service provider focusing exclusively on seismic data acquisition (using towed streamer and ocean bottom node methodologies) and autonomous underwater vehicle (AUV) solutions. They do not execute advanced seismic data processing or imaging services on client data as a commercial service; instead, field data is passed to specialized processing partners.", "confidence": "high"}, {"name": "PT DataSeismic Geophysical Services", "reason": "The company provides onshore field seismic acquisition design, QC, and processing services using mobile centers, but does not provide advanced marine/offshore seismic data processing services (such as FWI or RTM) for client-provided marine data as its core commercial offering.", "confidence": "high"}, {"name": "Mayfair Energy Ltd", "reason": "Mayfair Energy Ltd is primarily a geophysical and seismic data acquisition company deploying field equipment and surveys (land, OBN, transition zone), rather than a marine seismic data processing service provider.", "confidence": "high"}, {"name": "Benthic USA LLC", "reason": "Specializes in offshore marine geotechnical site investigations, subsea core drilling (PROD technology), and laboratory soil testing rather than marine seismic data processing and imaging services.", "confidence": "high"}, {"name": "Horizon Geosciences Limited", "reason": "The company delivers high-resolution 2D seismic processing, offshore data interpretation, and digital data processing, but its services are tailored to geotechnical surveys, geohazard assessments, and civil engineering/wind farm foundations rather than deep-water marine seismic imaging for hydrocarbon exploration and appraisal using advanced methods like FWI/RTM.", "confidence": "high"}, {"name": "Argeo AS", "reason": "Primarily a provider of robotic and digital subsea data acquisition solutions using AUVs rather than executing the defined marine seismic data processing services in-house; it relies on strategic alliances (such as with Shearwater GeoServices) for processing capabilities.", "confidence": "high"}, {"name": "Ramtech Corp", "reason": "Although RAMTeCH offers 2D/3D seismic processing and labor-intensive pre-processing services via its Center for Remote Seismic Processing, its core business focuses on GIS data management and utility engineering, and it lacks verifiable evidence of executing advanced marine seismic data processing workflows (such as FWI, RTM, or broadband processing) for offshore oil and gas clients.", "confidence": "medium"}, {"name": "Forland Geophysical Services LLC", "reason": "Although a seismic data processing service provider, the company explicitly focuses on land and shallow-water environments ('For Land') rather than the defined deep marine offshore seismic data processing services market.", "confidence": "high"}, {"name": "Earth Signal Processing Ltd.", "reason": "The company explicitly states that it is dedicated exclusively to processing land seismic data (2D and 3D land data), which disqualifies it from the marine seismic data processing market.", "confidence": "high"}, {"name": "Excel Geophysical Services, Inc.", "reason": "The company has ceased all corporate operations and closed its business permanently. Furthermore, it historically focused on land-based rather than marine offshore seismic data processing.", "confidence": "high"}, {"name": "The Geo People Ltd", "reason": "The Geo People Ltd is primarily a global QC/QA and HSE consultancy providing specialized oversight, pre-processing data treatment, and validation rather than executing advanced seismic data processing and imaging workflows internally for clients.", "confidence": "high"}, {"name": "Sterling Seismic Services, Ltd.", "reason": "The company specializes in land seismic data processing, borehole/VSP services, and microseismic data analysis across major US basins, and does not provide commercial marine/offshore seismic data processing services.", "confidence": "high"}, {"name": "Seitel Holdings, Inc.", "reason": "Primarily acts as a multi-client seismic library data vendor that acquires and licenses seismic data rather than executing third-party service processing for a fee.", "confidence": "high"}, {"name": "NuSeis Geophysical Services Inc.", "reason": "NuSeis is a proprietary wireless nodal seismic acquisition technology brand under Geophysical Technology Inc. (GTI), focusing on manufacturing and supplying recording hardware rather than executing processing services.", "confidence": "high"}, {"name": "Aker Geo AS", "reason": "Aker Geo AS was renamed to First Geo in 2015 following a spin-off and was primarily a subsurface consultancy offering interpretation, modeling, and depth conversion solutions rather than a standalone processing service provider, and the historical Aker Geo seismic acquisition arm was integrated into other entities or discontinued long ago.", "confidence": "high"}, {"name": "Strata Seismic Data Services Ltd", "reason": "The company develops and sells 'Strata CRM', a software system designed specifically for GIS and seismic operation tracking and estimation rather than executing seismic data processing services themselves.", "confidence": "high"}, {"name": "Inverness Seismic Processing Ltd.", "reason": "This specific company name and connection to the market cannot be verified via public corporate registries or market data.", "confidence": "high"}, {"name": "GEO Resources Consultancy", "reason": "The company operates primarily as an Earth sciences and environmental consultancy firm providing project design, acquisition planning, technical auditing, and geophysical quality control (QC) supervision rather than executing commercial data processing services.", "confidence": "high"}, {"name": "Deep Ocean Underwater Services", "reason": "The corporate presence and actual commercial service offerings of this company under this specific name/URL could not be verified.", "confidence": "high"}, {"name": "Dawson Geophysical Company", "reason": "The company is a service provider but focuses almost exclusively on onshore (land-based) and transition-zone seismic data acquisition and processing, which excludes it from the defined marine/offshore market.", "confidence": "high"}, {"name": "RPS Group Limited", "reason": "A multidisciplinary consultancy that provides client quality control (QC) supervision, project management, and advisory services for seismic workflows rather than executing data processing services itself.", "confidence": "high"}, {"name": "Horizon Geosciences", "reason": "Horizon Geosciences provides hydrographic and offshore shallow-surface site investigation/geophysical surveys (mapping seabed hazards and route geophysics using high-resolution tools) but does not operate as a commercial deep-reservoir marine seismic processing and advanced imaging service provider.", "confidence": "high"}, {"name": "Geoex MCG Ltd", "reason": "Operating primarily as a multi-client seismic data library provider, the company licenses datasets but outsources its data processing and reprocessing execution to third-party contractors like DUG Technology and RockWave.", "confidence": "high"}, {"name": "Geopartners Ltd", "reason": "Geopartners Ltd is a multi-client project management and data library vendor that utilizes third-party technical partners (such as DUG, Shearwater, and Rockwave) to execute its seismic processing workflows rather than executing them directly as a primary commercial service provider.", "confidence": "high"}, {"name": "PanGeo Subsea Inc.", "reason": "Executes high-resolution sub-bottom acoustic imaging services, but its focus is exclusively on near-surface geotechnical hazards, boulder detection, and cable burial depth for renewables and civil engineering rather than the deep marine seismic data processing defined for hydrocarbon exploration.", "confidence": "high"}, {"name": "OpenGeo Solutions Inc.", "reason": "OpenGeo Solutions primarily functions as a standalone software developer providing the OpenSEIS processing technology toolkit and focused algorithms (e.g., spectral decomposition) rather than operating as an independent commercial marine data processing service contractor.", "confidence": "high"}, {"name": "ERC Equipoise Ltd.", "reason": "Acts as an independent energy consultancy and reservoir evaluation firm providing seismic interpretation, velocity modeling, and depth conversion as part of advisory services and Competent Person's Reports (CPRs), rather than operating as a commercial seismic data processing service provider.", "confidence": "high"}, {"name": "Seismic Ventures, Inc.", "reason": "Seismic Ventures LLC merged into and became part of SEIMAX Technologies LP in 2015. It no longer operates as an independent service provider.", "confidence": "high"}, {"name": "Next Geosolutions Europe SpA", "reason": "The company is an offshore marine geoscience and hydrographic survey service provider specializing in geotechnical, environmental, and UXO surveys, as well as high-resolution engineering geophysics (side-scan sonar, sub-bottom profiling). It does not execute deep marine seismic data processing or advanced imaging services (such as FWI, RTM, or depth imaging) for hydrocarbon exploration and appraisal on client datasets.", "confidence": "high"}, {"name": "Kappa Offshore Solutions SAS", "reason": "Specializes in marine engineering, equipment integration (e.g., PIKSEL, KappaSpark systems), and acquisition field QC/hydrodynamic modeling rather than executing the core client-data processing workflows themselves.", "confidence": "high"}, {"name": "EPI Group Limited", "reason": "EPI Group specializes in seismic data processing quality control, positioning audits, and survey design analysis rather than executing primary seismic data processing services itself.", "confidence": "high"}, {"name": "DECO Geophysical Co. Ltd.", "reason": "DECO Geophysical is primarily a software company known for developing and commercialising the RadExPro seismic processing software package. Although they mention offering basic processing services, their primary business model and market presence focus on software licensing rather than acting as a dedicated marine seismic data processing service provider.", "confidence": "high"}, {"name": "Tsunami Development", "reason": "Tsunami Development is a geoscience software solutions company specializing in the design and licensing of subsurface imaging and migration software (such as PSTM, PSDM, and RTM applications) rather than executing seismic data processing workflows as a commercial service provider for external clients.", "confidence": "high"}, {"name": "Thrust Belt Imaging Inc. (TBI)", "reason": "While it operates as a commercial service provider, it is explicitly a land-focused processing company specialized in complex onshore settings and fold-thrust belts rather than marine data processing.", "confidence": "high"}, {"name": "Geodevice", "reason": "Geodevice is primarily a developer and manufacturer of geophysical equipment and software systems rather than a commercial service provider executing processing workflows on client-provided marine datasets.", "confidence": "high"}, {"name": "Gulfstar Geophysical", "reason": "Gulfstar Geophysical primarily operates as a specialized land and marine seismic data acquisition company that designs and executes physical surveys (using ocean bottom node and nodal technology) rather than acting as a standalone processing service provider for client-provided data.", "confidence": "medium"}, {"name": "Nanometrics Inc.", "reason": "Primarily a manufacturer and provider of precision instrumentation and turnkey systems for passive seismic, earthquake early warning, and environmental monitoring. While they provide data management/processing for passive/microseismic networks, they do not offer commercial marine seismic imaging, processing, or reprocessing services for hydrocarbon exploration data.", "confidence": "high"}, {"name": "Geoscience Seismic Services Corporation", "reason": "The existence of this company as an independent commercial marine seismic data processing service provider cannot be verified in current market operations.", "confidence": "high"}, {"name": "SismOcean SARL", "reason": "Focuses on shallow near-surface marine geophysical surveys for civil engineering, offshore wind farms, and geotechnical integration rather than processing deep seismic datasets for hydrocarbon exploration.", "confidence": "high"}, {"name": "Saudi Geophysical Company", "reason": "The company provides QA/QC supervision and oversight for offshore data processing projects rather than directly executing the seismic data processing workflows itself.", "confidence": "high"}, {"name": "SAExploration Inc.", "reason": "Primarily a marine and transition zone seismic data acquisition operator providing infield quality control (QC), rather than a standalone processing service provider executing advanced imaging workflows like FWI or RTM.", "confidence": "high"}, {"name": "The Geo People", "reason": "Acts as an independent quality control (QC) consultancy that supervises, audits, and manages seismic projects rather than executing the core data processing workflows directly.", "confidence": "high"}, {"name": "Petrosys Group", "reason": "Develops, licenses, and sells 'Claritas' (Globe Claritas) seismic data processing software, rather than operating primarily as a service provider executing processing tasks for client-provided data.", "confidence": "high"}, {"name": "Dark Ocean Private Limited", "reason": "Specializes in AI-driven hydrographic charting, satellite-derived bathymetry, and shallow subsea robotic surveys, with no verified commercial operations as a deep marine seismic processing house.", "confidence": "high"}, {"name": "SismOcean", "reason": "The company provides marine seismic refraction and near-surface site survey services for engineering, windfarms, and construction, rather than advanced imaging and processing of deep datasets for hydrocarbon exploration and appraisal as specified in the market definition.", "confidence": "high"}, {"name": "Vantage Geophysical Corporation", "reason": "Provides land, inland marine, and lacustrine seismic acquisition and processing services, which does not qualify under the strict definition of marine (offshore) seismic data processing.", "confidence": "high"}, {"name": "Lynx Information Systems Limited", "reason": "Focuses primarily on geophysical data management, GIS services, and software solutions for seismic vectorization/reconstruction rather than executing full advanced marine data processing workflows.", "confidence": "high"}, {"name": "Baker Hughes Company", "reason": "Primarily an oilfield technology and equipment supplier focusing on borehole seismic (VSP), logging-while-drilling (LWD) services, and subsurface interpretation rather than executing commercial offshore surface seismic data processing services.", "confidence": "high"}, {"name": "MacShane Geophysical Inc.", "reason": "The company primarily operates as an independent consultancy providing third-party seismic data quality control (QC) and client representation/supervision services, rather than acting as a full commercial data processing service provider executing the software workflows itself.", "confidence": "high"}, {"name": "Deepocean Engineering LLC", "reason": "A subsea engineering, project management, and installation company; it does not provide commercial marine seismic data processing or imaging services.", "confidence": "high"}, {"name": "Baker Hughes", "reason": "Primarily an oilfield technology and equipment supplier focusing on borehole seismic (VSP), logging-while-drilling (LWD) services, and subsurface interpretation rather than executing commercial offshore surface seismic data processing services.", "confidence": "high"}, {"name": "Fugro", "reason": "While Fugro performs marine seismic acquisition and specialized high-resolution processing (UUHR), its processing services focus on geointelligence and site characterization for offshore infrastructure/wind farm foundations rather than deep dataset workflows for hydrocarbon exploration and appraisal.", "confidence": "high"}, {"name": "Geokinetics Inc.", "reason": "The company officially ceased operations and filed for Chapter 11 liquidation in late 2018, meaning it is no longer an active commercial service provider in the market.", "confidence": "high"}, {"name": "EMGS", "reason": "EMGS specializes in marine controlled-source electromagnetic (CSEM) and magnetotelluric (MT) data acquisition and processing. While it integrates electromagnetic datasets with seismic data, it is not a provider of commercial standalone marine seismic data processing services.", "confi