initions": {"x": {"Product Pipeline Depth": "Number and stage of biologic and biosimilar candidates in development, including both innovative and biosimilar programs. Strength is evidenced by a robust pipeline with multiple candidates in late-stage trials.", "Manufacturing Scale & Capability": "Capacity and sophistication of biologics manufacturing facilities, including cell culture, purification, and fill-finish capabilities. Strength is shown by large-scale production capacity and advanced single-use technologies.", "Analytical & Characterization Expertise": "Ability to perform comprehensive analytical testing and characterization of biologics, including comparability studies for biosimilars. Strength is indicated by state-of-the-art labs and published studies demonstrating similarity.", "Regulatory Approval Track Record": "History of obtaining regulatory approvals for biologics and biosimilars from major agencies like FDA, EMA, and PMDA. Strength is evidenced by a high number of approved products and successful inspections.", "Technology Platform Innovation": "Adoption and development of novel platforms such as continuous manufacturing, advanced cell lines, or novel delivery systems. Strength is shown by patents, proprietary platforms, and collaborations on next-gen technologies."}, "y": {"Global Market Presence": "Geographic footprint in key markets (US, EU, Japan, emerging markets) with regulatory approvals and commercial infrastructure. Strength is evidenced by a wide sales network and product availability across regions.", "Revenue & Growth Trajectory": "Financial performance including revenue from biologics/biosimilars, year-over-year growth, and profitability. Strength is shown by consistent revenue growth and strong margins.", "Customer Base & Partnerships": "Breadth and depth of relationships with healthcare providers, payers, and strategic partners. Strength is indicated by long-term contracts, distribution agreements, and collaborations with major pharma.", "Biosimilar Price Competitiveness": "Pricing strategy and market access for biosimilars relative to originators and competitors. Strength is evidenced by significant discounts, formulary placements, and market share gains.", "Supply Chain Resilience": "Robustness of supply chain including multiple manufacturing sites, diversified suppliers, and contingency plans. Strength is shown by reliable product supply, minimal shortages, and investment in redundancy."}}, "x_features": ["Product Pipeline Depth", "Manufacturing Scale & Capability", "Analytical & Characterization Expertise", "Regulatory Approval Track Record", "Technology Platform Innovation"], "y_features": ["Global Market Presence", "Revenue & Growth Trajectory", "Customer Base & Partnerships", "Biosimilar Price Competitiveness", "Supply Chain Resilience"], "x_feature_weights": [0.3, 0.2, 0.2, 0.15, 0.15], "y_feature_weights": [0.25, 0.25, 0.2, 0.15, 0.15], "question_weights": [0.4, 0.3, 0.3], "overall_formula": "(X + Y) / 2", "quadrant_mid_x": 53.0, "quadrant_mid_y": 57.0, "scored": 237, "crawl": {"crawled": 75, "ok": 1, "fail": 74, "skipped_no_domain": 0}, "relevance": {"input": 238, "geo_artifacts": 0, "heuristic_drop": 0, "llm_drop": 1, "kept": 237, "player_type": "consumer", "keep_roles": ["Brand", "Marketer"]}}, "detail_rows": [{"Brand": "Biocon", "Company": "Biocon", "Role": "Manufacturer", "Quadrant": "Leaders", "X": 89, "Y": 81, "Overall": 85, "Found in": "India", "_meta": {"company": "Biocon", "company_raw": "Biocon", "brand": "Biocon", "parent": "Not publicly disclosed", "parent_or_independent": "Not publicly disclosed", "parent_owner": "", "ownership_relation": "", "founded_in": "Not publicly disclosed", "founded_year": "Not publicly disclosed", "hq_location": "India, Its, U.S", "founded_location": "India, Its, U.S", "evidence_snapshot": null, "commercial_role": "Manufacturer", "legal_name": "Biocon"}}, {"Brand": "Roche", "Company": "Roche", "Role": "Manufacturer", "Quadrant": "Leaders", "X": 8