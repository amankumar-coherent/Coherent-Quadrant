tionships": {"customers": [], "investors": []}, "intel": {"summary": "Akeso is a Chinese biopharmaceutical company with a strong focus on oncology, autoimmune, inflammatory, and metabolic diseases. It leverages a unique end-to-end R&D platform (ACE Platform) and various advanced technologies, including AI, bispecific antibodies, ADC, and mRNA, to develop first-in-class and best-in-class drugs. The company actively seeks global partnerships for co-development and licensing, positioning itself as a global player in the biopharmaceutical industry.", "insights": ["Akeso's multi-technology platform approach indicates a broad pipeline and potential for differentiated therapeutics.", "Its emphasis on global collaboration suggests an international expansion strategy, which could enhance its market reach and R&D capabilities."]}, "media": {"articles": [], "press_releases": [], "investor_presentations": []}}, "page_text": "Akeso is a Chinese biopharmaceutical company with a strong focus on oncology, autoimmune, inflammatory, and metabolic diseases. It leverages a unique end-to-end R&D platform (ACE Platform) and various advanced technologies, including AI, bispecific antibodies, ADC, and mRNA, to develop first-in-class and best-in-class drugs. The company actively seeks global partnerships for co-development and licensing, positioning itself as a global player in the biopharmaceutical industry.", "discovery_snippets": [], "classify": {"summary": "Akeso — channel participant (chatgpt_recall). Verify: Developing innovative biologics including bispecific antibodies. | Akeso is a biopharmaceutical company developing innovative biologics including bispecific antibodies. | China | Zhongshan, Guangdong, China", "role_description": "Brand"}}, "X Score": "70", "Y Score": "56", "Overall Score": "63", "Industry Category": "Healthcare / Biotechnology", "Quadrant": "Trailblazers"}, {"Company": "Alexion Pharmaceuticals", "Website": "https://alexion.com", "Founded": "Not publicly disclosed"