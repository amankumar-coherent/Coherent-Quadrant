l#values [102]: /sustainability/partnerships-and-alliances.html [103]: /sustainability/resources.html [104]: /sustainability/resources.html [105]: /sustainability/resources/our-impact", "discovery_snippets": [], "classify": {"summary": "AstraZeneca — channel participant (chatgpt_recall). Verify: AstraZeneca markets biologic therapies including immunotherapies. | AstraZeneca markets biologic therapies including immunotherapies and respiratory biologics. | United Kingdom | Cambridge, United Kingdom", "role_description": "Brand"}}, "X Score": "77", "Y Score": "71", "Overall Score": "74", "Industry Category": "Healthcare / Biotechnology", "Quadrant": "Leaders"}, {"Company": "AstraZeneca do Brasil", "Website": "https://www.astrazeneca.com.br", "Founded": "Not publicly disclosed", "Headquarters": "Cotia, Brazil", "Continent / Geography": "LATAM(Brazil)", "Operational Presence": "Brazil", "Ownership": "Not publicly disclosed", "Employees": "Not publicly disclosed", "Core Categories": "Not publicly disclosed", "Specialty Focus": "Brazilian subsidiary of AstraZeneca, with biologic products in its portfolio.", "Key Brands Represented": "Not publicly disclosed", "Retail / E-commerce / Both": "No", "Distribution Type": "Brand", "Contact Person": "", "Role": "Brand", "Email": "", "LinkedIn": "", "Office No.": "", "Country Code": "BR", "Region Code": "LATAM", "Summary": "AstraZeneca do Brasil — channel participant (openai_web_search_discover). Verify: Brazilian subsidiary of AstraZeneca, with biologic products in its portfolio; owns and markets its products.", "Data Sources": "google_ai", "Data Confidence": "Medium", "Quality Score": "3", "commercial_role": "Brand", "verify_confidence": "90", "_evidence_snapshot": {"source": "", "domain": "astrazeneca.com.br", "data": {"company": {"name": "astrazeneca.com.br"}, "business": {"products": [], "services": []}, "intel": {"summary": "* [Skip to content][1]\n* [Skip to navigation][2]\n* [Skip to footer][3]\n[AstraZeneca logo] [AstraZeneca logo]\n[ [AstraZeneca logo] [AstraZeneca logo] ][4]\nPesquisar Menu\nPesquisar Pesquisar Pesquisar Fechar\n* [ Sobre a AstraZeneca ][5]\n  * [ AstraZeneca Mundo ][6]\n  * [ AstraZeneca Brasil ][7]\n  * [ Iniciativas Corporativas ][8]\n* [ Nossas áreas terapêuticas ][9]\n  * [ Nossas áreas terapêuticas ][10]\n  * [ Doenças Cardiovasculares, Renais & Metabólicas ][11]\n  * [ Respiratória & Imunologia ][12]\n  * [ Oncologia ][13]\n  * [ Biofarmacêuticos ][14]\n  * [ Doenças Raras ][15]\n  * [ Vacinas e terapias imunes ][16]\n  * [ Ciclo de vida de um medicamento ][17]\n* [ Trabalhar na AZ ][18]\n* [ Paciente em Primeiro Lugar ][19]\n  * [ Paciente em Primeiro Lugar ][20]\n  * [ Bulas para Pacientes ][21]\n  * [ Bulas para os Profissionais ][22]\n  * [ Informações Comerciais de Produtos ][23]\n* [ Farmacovigilância ][24]\n* [ Sustentabilidade ][25]\n  * [ Sustentabilidade ][26]\n  * [ Ética e Compliance ][27]\n  * [ Clima & natureza ][28]\n  * [ Laudo Técnico ][29]\n  * [ Responsabilidade Social ][30]\n  * [ Inclusão e diversidade ][31]\n  * [ Acesso à Saúde ][32]\n  * [ Leis de incentivo ][33]\n  * [ Resiliência dos Sistemas de Saúde ][34]\n  * [ Apoio aos pacientes ][35]\n  * [ Equidade em Saúde ][36]\n* [ Profissionais de Saúde ][37]\n* [ Contatos ][38]\n  * [ Contatos Gerais ][39]\n  * [ Bula para pacientes ][40]\n  * [ Informações comerciais de produto ][41]\n  * [ Descontinuados ][42]\n  * [ Em falta ][43]\n  * [ Perguntas frequentes ][44]\n  * [ Press Release ][45]\n* Mais Esconder\n* [AstraZeneca Websites][46]\n* [ Global site][47]\n[Pessoa sorridente em destaque representando missão da AstraZeneca de expandir fronteiras da\nciência]\n\n## AstraZeneca Brasil\n\nNossa missão é expandir as fronteiras da ciência para oferecer medicamentos que mudam vidas.\n\n[ Ver áreas ][48]\n[Pessoa com elementos visuais de DNA representando pesquisa em oncologia da AstraZeneca\nfarmacêutica]\n\n## Áreas terapêuticas\n\nAcreditamos que a melhor forma de ajudar os pacientes é focando no poder da ciência.\n\n[ Saiba Mais ][49]\n[Duas pessoas conversando em ambiente acolhedor representando diversidade e inclusão na AstraZeneca\nfarmacêutica]\n\n## Diversidade e inclusão\n\nUsamos o poder da diversidade para criarmos um ambiente equitativo onde as pessoas sentem orgulho de\npertencer.\n\n[ Saiba Mais ][50]\n\n\n# Inovação farmacêutica para transformar a saúde\n\n## A grande diferença\n\nInspirados por nosso propósito e valores, estamos transformando o futuro da saúde ao explorar tudo o\nque a ciência pode fazer – pelas pessoas, pela sociedade e pelo planeta.\n\n[ Assista ao vídeo ][51]\n[Thumbnail de pessoa em rua da cidade representando propósito e valores da AstraZeneca farmacêutica]\n[Play]\n[Fechar]\n\n## Nossas áreas terapêuticas\n\n\n[ [Pessoa com elementos visuais de DNA representando pesquisa em oncologia da AstraZeneca\nfarmacêutica]\n\n### Oncologia\n\n][52] [ [Figura em tons azuis com estruturas moleculares simbolizando estudos cardiovasculares,\nrenais e metabólicos da AstraZeneca farmacêutica]\n\n### Cardiovascular, Renal e Metabolismo\n\n][53] [ [Pessoa soprando dente-de-leão ilustrando pesquisa respiratória e imunológica da AstraZeneca\nfarmacêutica]\n\n### Respiratória e Imunologia\n\n][54] [Idoso e criança sorrindo cercados por elementos moleculares representando vacinas e terapias\nimunes da AstraZeneca farmacêutica]\n\n### Vacinas e Terapias Imunes\n\n[Pessoa em tons rosados com figuras ao fundo simbolizando pesquisa em doenças raras da AstraZeneca\nfarmacêutica]\n\n### Doenças Raras\n\n\n[Imagem Esquerda]\n\nConteúdos, dicas e\nbenefícios exclusivos.\n\n[ Conheça [Ícone] ][55]\n[Imagem Direita]\n\nO portal da AstraZeneca\npara profissionais\nde saúde.\n\n[ Acesse [Ícone] ][56]\n[Logo Inferior]\nJunte-se a nós e descubra\no poder de ser AstraZeneca.\n[ Trabalhe conosco [Ícone] ][57]\n\n## Saiba mais sobre a AstraZeneca\n\n[ [Pessoa de jaleco sorrindo em mesa de atendimento representando o SAC da AstraZeneca farmacêutica]\n\n## SAC\n\nUm canal para tirar dúvidas "}}, "page_text": "* [Skip to content][1] * [Skip to navigation][2] * [Skip to footer][3] [AstraZeneca logo] [AstraZeneca logo] [ [AstraZeneca logo] [AstraZeneca logo] ][4] Pesquisar Menu Pesquisar Pesquisar Pesquisar Fechar * [ Sobre a AstraZeneca ][5] * [ AstraZeneca Mundo ][6] * [ AstraZeneca Brasil ][7] * [ Iniciativas Corporativas ][8] * [ Nossas áreas terapêuticas ][9] * [ Nossas áreas terapêuticas ][10] * [ Doenças Cardiovasculares, Renais & Metabólicas ][11] * [ Respiratória & Imunologia ][12] * [ Oncologia ][13] * [ Biofarmacêuticos ][14] * [ Doenças Raras ][15] * [ Vacinas e terapias imunes ][16] * [ Ciclo de vida de um medicamento ][17] * [ Trabalhar na AZ ][18] * [ Paciente em Primeiro Lugar ][19] * [ Paciente em Primeiro Lugar ][20] * [ Bulas para Pacientes ][21] * [ Bulas para os Profissionais ][22] * [ Informações Comerciais de Produtos ][23] * [ Farmacovigilância ][24] * [ Sustentabilidade ][25] * [ Sustentabilidade ][26] * [ Ética e Compliance ][27] * [ Clima & natureza ][28] * [ Laudo Técnico ][29] * [ Responsabilidade Social ][30] * [ Inclusão e diversidade ][31] * [ Acesso à Saúde ][32] * [ Leis de incentivo ][33] * [ Resiliência dos Sistemas de Saúde ][34] * [ Apoio aos pacientes ][35] * [ Equidade em Saúde ][36] * [ Profissionais de Saúde ][37] * [ Contatos ][38] * [ Contatos Gerais ][39] * [ Bula para pacientes ][40] * [ Informações comerciais de produto ][41] * [ Descontinuados ][42] * [ Em falta ][43] * [ Perguntas frequentes ][44] * [ Press Release ][45] * Mais Esconder * [AstraZeneca Websites][46] * [ Global site][47] [Pessoa sorridente em destaque representando missão da AstraZeneca de expandir fronteiras da ciência] ## AstraZeneca Brasil Nossa missão é expandir as fronteiras da ciência para oferecer medicamentos que mudam vidas. [ Ver áreas ][48] [Pessoa com elementos visuais de DNA representando pesquisa em oncologia da AstraZeneca farmacêutica] ## Áreas terapêuticas Acreditamos que a melhor forma de ajudar os pacientes é focando no poder da ciência. [ Saiba Mais ][49] [Duas pessoas conversando em ambiente acolhedor representando diversidade e inclusão na AstraZeneca farmacêutica] ## Diversidade e inclusão Usamos o poder da diversidade para criarmos um ambiente equitativo onde as pessoas sentem orgulho de pertencer. [ Saiba Mais ][50] # Inovação farmacêutica para transformar a saúde ## A grande diferença Inspirados por nosso propósito e valores, estamos transformando o futuro da saúde ao explorar tudo o que a ciência pode fazer – pelas pessoas, pela sociedade e pelo planeta. [ Assista ao vídeo ][51] [Thumbnail de pessoa em rua da cidade representando propósito e valores da AstraZeneca farmacêutica] [Play] [Fechar] ## Nossas áreas terapêuticas [ [Pessoa com elementos visuais de DNA representando pesquisa em oncologia da AstraZeneca farmacêutica] ### Oncologia ][52] [ [Figura em tons azuis com estruturas moleculares simbolizando estudos cardiovasculares, renais e metabólicos da AstraZeneca farmacêutica] ### Cardiovascular, Renal e Metabolismo ][53] [ [Pessoa soprando dente-de-leão ilustrando pesquisa respiratória e imunológica da AstraZeneca farmacêutica] ### Respiratória e Imunologia ][54] [Idoso e criança sorrindo cercados por elementos moleculares representando vacinas e terapias imunes da AstraZeneca farmacêutica] ### Vacinas e Terapias Imunes [Pessoa em tons rosados com figuras ao fundo simbolizando pesquisa em doenças raras da AstraZeneca farmacêutica] ### Doenças Raras [Imagem Esquerda] Conteúdos, dicas e benefícios exclusivos. [ Conheça [Ícone] ][55] [Imagem Direita] O portal da AstraZeneca para profissionais de saúde. [ Acesse [Ícone] ][56] [Logo Inferior] Junte-se a nós e descubra o poder de ser AstraZeneca. [ Trabalhe conosco [Ícone] ][57] ## Saiba mais sobre a AstraZeneca [ [Pessoa de jaleco sorrindo em mesa de atendimento representando o SAC da AstraZeneca farmacêutica] ## SAC Um canal para tirar dúvidas e ouvir você. ][58] [ [Globo digital em pontos rosados simbolizando o site global da AstraZeneca farmacêutica] ## Site Global AstraZeneca Nossa atuação ao redor do mundo. ][59] [ [Pessoa entre árvores iluminadas pelo sol representando iniciativas de sustentabilidade da AstraZeneca farmacêutica] ## Sustentabilidade Focamos em gerar um impacto positivo em toda a cadeia de valor. ][60] [ [Pessoa sorridente ao ar livre ilustrando programas de incentivo fiscal apoiados pela AstraZeneca farmacêutica] ## Leis de Incentivo Fiscal Ampliamos o acesso à saúde para gerar impacto positivo nas comunidades. ][61] [ [Profissional de saúde com estetoscópio conversando com paciente representando apoio da AstraZeneca farmacêutica] ## Apoio aos pacientes Colaboramos com associações de pacientes para priorizar o cuidado no centro de tudo. ][62] [ [Duas pessoas olhando para tablet simbolizando área de imprensa da AstraZeneca farmacêutica] ## Imprensa As últimas novidades da AstraZeneca Brasil. ][63] BR-47343 | Janeiro/2026 [Voltar para o topo] ### [Website AstraZeneca][64] Site destinado a informações sobre a AstraZeneca do Brasil. Temos sites específicos, nacionais e internacionais, dirigidos a pacientes e a profissionais de saúde. Website PromoMats ID: BR-36147 Última Revisão: 12/2024 ### Social Media * [LinkedIn][65] * [Instagram][66] #### utility links * [Declaração Legal][67] * [Política de Privacidade][68] * [Código de ética][69] * [AZethics - Canal de Denúncias][70] * [Política de Cookies][71] © AstraZeneca 2024 **Você está saindo de AstraZeneca.com.br** Você selecionou um link que te direcionará para um site terceiro o qual é responsável pelos seus próprios conteúdos. A AstraZeneca fornece esse link como um serviço para nossos visitantes. A AstraZeneca não é responsável pela política de privacidade de qualquer site terceiro. Nós o encorajamos a ler a politica de privacidade de qualquer site que você visitar. Clique 'Cancelar' para retornar ao site da Astrazeneca ou 'Continuar' para seguir. [Cancelar][72] [Continuar][73] *