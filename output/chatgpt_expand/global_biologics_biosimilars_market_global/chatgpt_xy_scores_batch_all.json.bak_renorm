{
  "industry_group": "Healthcare",
  "industry_category": "Biotechnology",
  "axis_x": "Product Strength",
  "axis_y": "Business Strategy",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the critical success factors in biologics and biosimilars: scientific and manufacturing excellence for X, and commercial execution and market dynamics for Y, tailored to the specific challenges of this market.",
  "parameter_definitions": {
    "x": {
      "Product Pipeline Depth": "Number and stage of biologic and biosimilar candidates in development, including both innovative and biosimilar programs. Strength is evidenced by a robust pipeline with multiple candidates in late-stage trials.",
      "Manufacturing Scale & Capability": "Capacity and sophistication of biologics manufacturing facilities, including cell culture, purification, and fill-finish capabilities. Strength is shown by large-scale production capacity and advanced single-use technologies.",
      "Analytical & Characterization Expertise": "Ability to perform comprehensive analytical testing and characterization of biologics, including comparability studies for biosimilars. Strength is indicated by state-of-the-art labs and published studies demonstrating similarity.",
      "Regulatory Approval Track Record": "History of obtaining regulatory approvals for biologics and biosimilars from major agencies like FDA, EMA, and PMDA. Strength is evidenced by a high number of approved products and successful inspections.",
      "Technology Platform Innovation": "Adoption and development of novel platforms such as continuous manufacturing, advanced cell lines, or novel delivery systems. Strength is shown by patents, proprietary platforms, and collaborations on next-gen technologies."
    },
    "y": {
      "Global Market Presence": "Geographic footprint in key markets (US, EU, Japan, emerging markets) with regulatory approvals and commercial infrastructure. Strength is evidenced by a wide sales network and product availability across regions.",
      "Revenue & Growth Trajectory": "Financial performance including revenue from biologics/biosimilars, year-over-year growth, and profitability. Strength is shown by consistent revenue growth and strong margins.",
      "Customer Base & Partnerships": "Breadth and depth of relationships with healthcare providers, payers, and strategic partners. Strength is indicated by long-term contracts, distribution agreements, and collaborations with major pharma.",
      "Biosimilar Price Competitiveness": "Pricing strategy and market access for biosimilars relative to originators and competitors. Strength is evidenced by significant discounts, formulary placements, and market share gains.",
      "Supply Chain Resilience": "Robustness of supply chain including multiple manufacturing sites, diversified suppliers, and contingency plans. Strength is shown by reliable product supply, minimal shortages, and investment in redundancy."
    }
  },
  "x_features": [
    "Product Pipeline Depth",
    "Manufacturing Scale & Capability",
    "Analytical & Characterization Expertise",
    "Regulatory Approval Track Record",
    "Technology Platform Innovation"
  ],
  "y_features": [
    "Global Market Presence",
    "Revenue & Growth Trajectory",
    "Customer Base & Partnerships",
    "Biosimilar Price Competitiveness",
    "Supply Chain Resilience"
  ],
