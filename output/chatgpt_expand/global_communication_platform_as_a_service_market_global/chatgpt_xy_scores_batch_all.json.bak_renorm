{
  "industry_group": "ICT, Automation, Semiconductor",
  "industry_category": "Information and Communication Technology",
  "axis_x": "Product Strength",
  "axis_y": "Business Strength",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the unique CPaaS market dynamics: X focuses on API product depth, quality, and developer-centric infrastructure, while Y emphasizes adoption, revenue growth, ecosystem, and profitability—key differentiators in a platform-driven, developer-first market.",
  "parameter_definitions": {
    "x": {
      "API Breadth & Channel Coverage": "Range of communication APIs offered (SMS, voice, video, email, chat, WhatsApp, etc.) and number of channels supported. Strength shown by comprehensive, well-documented API catalog covering all major CPaaS use cases.",
      "Programmable Voice & Video Quality": "Reliability, latency, and global call quality for programmable voice and video services. Evidence includes uptime SLAs, codec support, and independent quality benchmarks.",
      "Omnichannel Messaging & Routing": "Ability to intelligently route messages across SMS, RCS, OTT apps, and email with high deliverability and low latency. Strength indicated by global carrier connections, smart routing algorithms, and delivery rate metrics.",
      "Developer Experience & Tooling": "Quality of SDKs, documentation, sandbox, debugging tools, and community support. Strong evidence includes extensive language SDKs, interactive docs, and active developer forums.",
      "Global Network & Compliance Infrastructure": "Owned or partnered network infrastructure and regulatory compliance across countries. Strength shown by direct carrier relationships, local number availability, and certifications (e.g., GDPR, HIPAA)."
    },
    "y": {
      "Developer & Enterprise Adoption": "Number of active developers and enterprise customers using the platform. Evidence includes disclosed customer counts, developer sign-ups, and case studies from large enterprises.",
      "Revenue Scale & Growth": "Total CPaaS revenue and year-over-year growth rate. Strength indicated by consistent double-digit growth, high net revenue retention, and increasing average revenue per user.",
      "Geographic & Vertical Expansion": "Presence in key regions and penetration into verticals like healthcare, finance, and retail. Evidence includes regional revenue splits, local partnerships, and vertical-specific solutions.",
      "Partner & Ecosystem Strength": "Depth of relationships with ISVs, SIs, and technology partners. Strength shown by marketplace listings, co-selling agreements, and revenue influenced by partners.",
      "Profitability & Unit Economics": "Gross margin, operating margin, and customer acquisition cost efficiency. Evidence includes improving margins, positive free cash flow, and low churn relative to acquisition spend."
    }
  },
  "x_features": [
    "API Breadth & Channel Coverage",
    "Programmable Voice & Video Quality",
    "Omnichannel Messaging & Routing",
    "Developer Experience & Tooling",
    "Global Network & Compliance Infrastructure"
  ],
  "y_features": [
    "Developer & Enterprise Adoption",
    "Revenue Scale & Growth",
    "Geographic & Vertical Expansion",
    "Partner & Ecosystem Strength",
    "Profitability & Unit Economics"
  ],
  "x_feature_weights": [
    0.3,
    0.2,
    0.2,
    0.15,
    0.15
  ],
  "y_feature_weights": [
