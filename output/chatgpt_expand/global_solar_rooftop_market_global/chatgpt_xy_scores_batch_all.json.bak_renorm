{
  "industry_group": "Others",
  "industry_category": "Energy",
  "axis_x": "Product Strength",
  "axis_y": "Business Strength",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the unique drivers of the global solar rooftop market: product strength focuses on efficiency, installation, durability, smart features, and supply chain, while business strength emphasizes geographic reach, customer metrics, financials, pipeline, and partnerships. They are concrete and assessable from public evidence such as product specs, financial reports, and market data.",
  "parameter_definitions": {
    "x": {
      "Module Efficiency & Power Density": "The conversion efficiency and power output per square meter of solar modules, critical for maximizing rooftop energy generation in limited space. Evidence includes third-party efficiency ratings, temperature coefficients, and performance under low-light conditions.",
      "System Design & Installation Quality": "The ease and speed of installing rooftop solar systems, including mounting structures, wiring, and inverter integration, which affects labor costs and system reliability. Strength shown by standardized kits, rapid installation times, and minimal roof penetration.",
      "Product Durability & Warranty": "The longevity and degradation rate of solar panels and components under real-world conditions, backed by comprehensive warranties. Evidence includes 25-year performance warranties, PID resistance, and certifications for harsh weather.",
      "Smart Monitoring & Grid Integration": "Advanced monitoring software and hardware that optimize energy production, enable remote diagnostics, and facilitate grid interaction. Strength indicated by real-time analytics, smart inverter capabilities, and compatibility with virtual power plants.",
      "Supply Chain & Manufacturing Scale": "The ability to produce and deliver solar components at scale with cost efficiency and supply reliability. Evidence includes vertical integration, production capacity, and lead times for key components like panels and inverters."
    },
    "y": {
      "Geographic Market Coverage": "The extent of sales and operations across different countries and regions, including local presence and adaptation to varying regulations. Strength shown by number of countries served, local offices, and revenue distribution.",
      "Customer Acquisition & Retention": "The ability to attract and keep residential, commercial, and industrial customers through effective sales and service. Evidence includes customer growth rates, churn rates, and net promoter scores.",
      "Financial Strength & Profitability": "The financial health and profitability of the company, including margins, cash flow, and balance sheet strength. Evidence includes gross margins, EBITDA, and return on invested capital.",
      "Project Pipeline & Growth Rate": "The volume of contracted and prospective rooftop solar projects, indicating future revenue potential. Strength shown by backlog size, year-over-year growth, and market share expansion.",
      "Channel Partnerships & Brand Equity": "The strength of relationships with distributors, installers, and financiers, plus brand recognition among consumers. Evidence includes partnership agreements, co-marketing, and brand surveys."
    }
  },
  "x_features": [
    "Module Efficiency & Power Density",
    "System Design & Installation Quality",
    "Product Durability & Warranty",
    "Smart Monitoring & Grid Integration",
    "Supply Chain & Manufacturing Scale"
  ],
