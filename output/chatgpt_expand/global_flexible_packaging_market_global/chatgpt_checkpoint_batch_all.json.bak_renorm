ricing": null}, {"name": "PlantCarton", "category": "Packaging brand", "features": [], "pricing": null}, {"name": "Recycleware", "category": "Packaging brand", "features": [], "pricing": null}, {"name": "Reynolon", "category": "Packaging brand", "features": [], "pricing": null}], "services": [], "industries": [], "key_markets": []}, "financials": {"revenue": null, "employee_count": null, "key_numbers": []}, "relationships": {"customers": [], "investors": []}, "intel": {"summary": "Pactiv Evergreen is a packaging company whose website highlights a portfolio of brands including EarthChoice, Greenware, Newspring, PlantCarton, Recycleware, and Reynolon, with the tagline 'Packaging a Better Future'.", "insights": ["The brand names (EarthChoice, Greenware, PlantCarton, Recycleware) suggest a strong focus on sustainable packaging solutions.", "The footer copyright mentions Novolex, indicating a potential parent or affiliated company, but no further details are available on this page.", "The page provides minimal operational information, lacking explicit product details, financials, and geographic market specifics."]}, "media": {"articles": [], "press_releases": [], "investor_presentations": []}}, "page_text": "Pactiv Evergreen is a packaging company whose website highlights a portfolio of brands including EarthChoice, Greenware, Newspring, PlantCarton, Recycleware, and Reynolon, with the tagline 'Packaging a Better Future'.", "discovery_snippets": [], "classify": {"summary": "Pactiv Evergreen — channel participant (seed_file). Verify: Pactiv Evergreen manufactures flexible packaging products such as bags, wraps, and pouches for foodservice and retail. | Brand / Marketer; web_confirmed_flex_pack_player | Foodservice; Food and Beverage Merchandising; Food Containers; Drinkware; Tableware & Serviceware; Beverage Cartons; Retail Food Packaging; Meat & Poultry Trays | EarthChoice; Greenware; PlantCarton; Newspring; Reynolon; SmartPour | United States; Canada; Mexico | seed_file", "role_description": "Brand / Marketer", "key_products": "Foodservice; Food and Beverage Merchandising; Food Containers; Drinkware; Tableware & Serviceware; Beverage Cartons; Retail Food Packaging; Meat & Poultry Trays"}}, "X Score": "64", "Y Score": "64", "Overall Score": "64", "Industry Category": "Others / Packaging", "Quadrant": "Trailblazers"}, {"Company": "Reynolds Consumer Products LLC", "Website": "https://reynoldsconsumer.com", "Founded": "Not publicly disclosed", "Headquarters": "Lake Forest, Illinois, USA", "Continent / Geography": "NA(United States)", "Operational Presence": "United States", "Ownership": "Subsidiary of Reynolds Consumer Products Inc. (NASDAQ: REYN); majority controlled by Rank Group Limited (Graeme Hart)", "Employees": "6000", "Core Categories": "Cooking products; Waste & storage products; Disposable tableware", "Specialty Focus": "Brand / Marketer; web_confirmed_flex_pack_player", "Key Brands Represented": "Reynolds Wrap; Hefty; Diamond; Alcan; Presto", "Retail / E-commerce / Both": "No", "Distribution Type": "Brand / Marketer", "Contact Person": "", "Role": "", "Email": "RCPCommunications@ReynoldsBrands.com; RCPLegalTeam@reynoldsbrands.com", "LinkedIn": "https://www.linkedin.com/company/reynolds-consumer-products", "Office No.": "(800) 879-5067 or (224) 295-6800", "Country Code": "US", "Region Code": "NA", "Summary": "Reynolds Consumer Products LLC — channel participant (seed_file). Verify: Reynolds produces flexible packaging products like aluminum foil, plastic wrap, and storage bags.", "Data Sources": "google_ai; openai_sdk_residual", "Data Confidence": "High", "Quality Score": "4", "commercial_role": "Brand / Marketer", "verify_confidence": "90", "_evidence_snapshot": {"source": "", "domain": "reynoldsconsumer.com", "data": {"company": {"name": "reynoldsconsumer.com"}, "business": {"products": [], "services": []}, "intel": {"summary": "Toggle navigation [[Reynolds Consumer Products LLC]][1]\n[Contact][2] [Linkedin][3][Glassdoor][4]\n* [About][5]\n* [Brands][6]\n* [News][7]\n* [Sustainability][8]\n* [Investors][9]\n* [Careers][10]\n[We Create Products People Love]\n[banner-2]\n[Simplify Daily Life]\n[banner-3]\n[safety is our top priority]\n[banner-6]\nPreviousNext\n[ABOUT US][11]\n[[home-about]][12]\n[OUR BRANDS][13]\n[[home-brands]][14]\n[CAREERS][15]\n[[All Jobs]][16]\n\n## LATEST NEWS\n\n[Hefty Ultra Strong Fabuloso Watermelon]\n\n## The Hefty® Brand Brings Strength and Sweetness to Trash Day with New Hefty® Ultra Strong™ Trash\n## Bags with Fabuloso® Watermelon Scent\n\nThe Hefty® brand just made trash day a whole lot sweeter! In its latest collaboration with the\nbeloved cleaning brand, Fabuloso®, the Hefty® brand is introducing a fruity new scent to its trash\nbag portfolio: Hefty® Ultra Strong™ with Fabuloso Watermelon Scent.\n\nThese new scented trash bags combine trusted strength, effective odor control technology, and\nsix-in-one protection with the sweet scent of watermelon—making even the toughest cleanup\nsurprisingly refreshing.\n\nNow available in a variety of sizes, the Hefty® Ultra Strong™ with Fabuloso Watermelon Scent line\nincludes top-selling tall kitchen bags in classic white and vibrant pink, plus options for larger\nand smaller cleanup needs. All sizes feature break-resistant drawstrings and continuous odor control\ntechnology, keeping unpleasant smells away, whether tackling kitchen trash, yard work, or refreshing\nbathroom bins.\n\nThe full Hefty® Ultra Strong™ with Fabuloso Watermelon Scent lineup includes:\n\nHefty® Ultra Strong™ Tall Kitchen Trash Bags (13 Gallon, MSRP: $9.49) – Lift the heftiest loads with\npowerful odor neutralization technology to combat kitchen smells. Available in traditional white as\nwell as a pink version to add a splash of color to your kitchen.\n\nHefty® Ultra Strong™ Large Trash Bags (30 Gallon, MSRP: $9.49) – Built for heavy-duty messes with\nflexible strength and extra capacity.\n\nHefty® Medium Trash Bags (8 Gallon, MSRP: $4.99) – Just right for bathrooms, bedrooms, or office\nbins—tough on trash, easy on the nose.\n\nHefty® Small Trash Bags (4 Gallon, MSRP: $4.99) – Compact but powerful, perfect for quick cleanups\nand small spaces.\n\n\"We’re thrilled that we're taking scent and color to the next level with our new Hefty® Ultra\nStrong™ with Fabuloso Watermelon Scent line,” said Brian Lutz, Marketing Director with Hefty® Waste.\n“The bold, pink bags paired with the fresh and fruity scent of watermelon offers a fun, stylish way\nto bring personality to your everyday clean-up routines.”\n\nThis latest drop from the Hefty® team builds on the success of the brand’s ongoing partnership with\nFabuloso, which has already introduced best-selling scented bags in classic favorites like lavender\nand lemon. Bring even more freshness to your home with the strength you need and a scent you’ll\nlove.\n\nIn support of the new product launch, the Hefty® brand is also excited to continue partnering with\nJohn Cena who will star in an integrated advertising campaign. The campaign will roll out across\nplatforms over the course of the year showcasing the strength and sweetness of the new scent.\n\nHefty® Ultra Strong™ with Fabuloso Watermelon Scent trash bags are now available at retailers\nnationwide. To find them at a store near you, visit [Hefty.com][17] for more information and follow\n@HeftyBrands on social for updates, tips, and fresh content.\n\nAbout Fabuloso\nFabuloso Multi-Purpose Cleaner is the perfect solution for anyone looking for an effective way to\nkeep their home clean and smelling great. With a 2X concentrated formula vs. non-concentrated\nFabuloso Original and long lasting freshness, our cleaners will fill your entire home with joy -\nfrom the kitchen to the bathroom and beyond. Fabuloso 2X Watermelon has a bright watermelon, citrus,\nand fruity fragrance rounded out with soft musks and powdery notes. We have a wide variety of\nfragrances to try, including Lavender, Peach, Refr"}}, "page_text": "Toggle navigation [[Reynolds Consumer Products LLC]][1] [Contact][2] [Linkedin][3][Glassdoor][4] * [About][5] * [Brands][6] * [News][7] * [Sustainability][8] * [Investors][9] * [Careers][10] [We Create Products People Love] [banner-2] [Simplify Daily Life] [banner-3] [safety is our top priority] [banner-6] PreviousNext [ABOUT US][11] [[home-about]][12] [OUR BRANDS][13] [[home-brands]][14] [CAREERS][15] [[All Jobs]][16] ## LATEST NEWS [Hefty Ultra Strong Fabuloso Watermelon] ## The Hefty® Brand Brings Strength and Sweetness to Trash Day with New Hefty® Ultra Strong™ Trash ## Bags with Fabuloso® Watermelon Scent The Hefty® brand just made trash day a whole lot sweeter! In its latest collaboration with the beloved cleaning brand, Fabuloso®, the Hefty® brand is introducing a fruity new scent to its trash bag portfolio: Hefty® Ultra Strong™ with Fabuloso Watermelon Scent. These new scented trash bags combine trusted strength, effective odor control technology, and six-in-one protection with the sweet scent of watermelon—making even the toughest cleanup surprisingly refreshing. Now available in a variety of sizes, the Hefty® Ultra Strong™ with Fabuloso Watermelon Scent line includes top-selling tall kitchen bags in classic white and vibrant pink, plus options for larger and smaller cleanup needs. All sizes feature break-resistant drawstrings and continuous odor control technology, keeping unpleasant smells away, whether tackling kitchen trash, yard work, or refreshing bathroom bins. The full Hefty® Ultra Strong™ with Fabuloso Watermelon Scent lineup includes: Hefty® Ultra Strong™ Tall Kitchen Trash Bags (13 Gallon, MSRP: $9.49) – Lift the heftiest loads with powerful odor neutralization technology to combat kitchen smells. Available in traditional white as well as a pink version to add a splash of color to your kitchen. Hefty® Ultra Strong™ Large Trash Bags (30 Gallon, MSRP: $9.49) – Built for heavy-duty messes with flexible strength and extra capacity. Hefty® Medium Trash Bags (8 Gallon, MSRP: $4.99) – Just right for bathrooms, bedrooms, or office bins—tough on trash, easy on the nose. Hefty® Small Trash Bags (4 Gallon, MSRP: $4.99) – Compact but powerful, perfect for quick cleanups and small spaces. \"We’re thrilled that we're taking scent and color to the next level with our new Hefty® Ultra Strong™ with Fabuloso Watermelon Scent line,” said Brian Lutz, Marketing Director with Hefty® Waste. “The bold, pink bags paired with the fresh and fruity scent of watermelon offers a fun, stylish way to bring personality to your everyday clean-up routines.” This latest drop from the Hefty® team builds on the success of the brand’s ongoing partnership with Fabuloso, which has already introduced best-selling scented bags in classic favorites like lavender and lemon. Bring even more freshness to your home with the strength you need and a scent you’ll love. In support of the new product launch, the Hefty® brand is also excited to continue partnering with John Cena who will star in an integrated advertising campaign. The campaign will roll out across platforms over the course of the year showcasing the strength and sweetness of the new scent. Hefty® Ultra Strong™ with Fabuloso Watermelon Scent trash bags are now available at retailers nationwide. To find them at a store near you, visit [Hefty.com][17] for more information and follow @HeftyBrands on social for updates, tips, and fresh content. About Fabuloso Fabuloso Multi-Purpose Cleaner is the perfect solution for anyone looking for an effective way to keep their home clean and smelling great. With a 2X concentrated formula vs. non-concentrated Fabuloso Original and long lasting freshness, our cleaners will fill your entire home with joy - from the kitchen to the bathroom and beyond. Fabuloso 2X Watermelon has a bright watermelon, citrus, and fruity fragrance rounded out with soft musks and powdery notes. We have a wide variety of fragrances to try, including Lavender, Peach, Refreshing Lemon, Passion of Fruits, Tropical Spring, Spring Fresh & Citrus & Fruits. FABULOSO® and the FABULOSO Logo® are trademarks of Colgate-Palmolive Company and are manufactured and sold under license. [Read Full Article][18] Copyright© 2026 Reynolds Consumer Products [Equal opportunity][19] | [ETHICS][20] | [Privacy & Legal][21] | [CONTACT][22] | Cookie Preferences [1]: / [2]: /contact [3]: http://www.linkedin.com/company/reynolds-consumer-products-inc [4]: https://www.glassdoor.com/Overview/Working-at-Reynolds-Consumer-Products-EI_IE478496.11,37.htm [5]: /about [6]: /brands [7]: /news [8]: https://investors.reynoldsconsumerproducts.com/esg [9]: https://investors.reynoldsconsumerproducts.com/ [10]: /careers [11]: https://www.reynoldsconsumerproducts.com/about [12]: https://www.reynoldsconsumerproducts.com/about [13]: https://www.reynoldsconsumerproducts.com/brands [14]: https://www.reynoldsconsumerproducts.com/brands [15]: https://www.reynoldsconsumerproducts.com/careers [16]: https://www.reynoldsconsumerproducts.com/careers [17]: https://www.hefty.com/ [18]: /news [19]: /equal-opportunity [20]: /ethics [21]: /privacy [22]: /contact", "discovery_snippets": [], "classify": {"summary": "Reynolds Consumer Products LLC — channel participant (seed_file). Verify: Reynolds produces flexible packaging products like aluminum foil, plastic wrap, and storage bags. | Brand / Marketer; web_confirmed_flex_pack_player | Cooking products; Waste & storage products; Disposable tableware | Reynolds Wrap; Hefty; Diamond; Alcan; Presto | United States | Lake Forest, Illinois, USA", "role_description": "Brand / Marketer", "key_products": "Cooking products; Waste & storage products; Disposable tableware"}}, "X Score": "64", "Y Score": "64", "Overall Score": "64", "Industry Category": "Others / Packaging", "Quadrant": "Trailblazers"}, {"Company": "Scientex Berhad", "Website": "https://www.scientex.com.my", "Founded": "1968", "Headquarters": "Malaysia", "Continent / Geography": "APAC(Malaysia)",