{
  "industry_group": "Healthcare",
  "industry_category": "Medical Devices",
  "axis_x": "Product Strength",
  "axis_y": "Business Strength",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters address the unique requirements of wearable glucometers: sensor accuracy, wearability, regulatory hurdles, manufacturing scale, and data integration on the product side; and reimbursement, clinical adoption, distribution, financials, and pipeline on the business side. They are concrete and assessable from public evidence such as clinical studies, regulatory databases, and financial reports.",
  "parameter_definitions": {
    "x": {
      "Sensor Accuracy & Reliability": "Measures the precision of continuous glucose readings versus gold-standard blood glucose, including MARD and stability over wear time. Evidence includes published clinical trials and regulatory submissions showing low error rates.",
      "Wearability & User Experience": "Assesses comfort, discreetness, wear duration, and ease of use for daily activities. Strength shown by user-reported outcomes, adherence rates, and design awards or patient preference studies.",
      "Regulatory Clearances & Compliance": "Covers FDA, CE, and other global approvals for wearable glucometers, including indications for diabetes management. Strength indicated by number of approvals, speed of clearance, and post-market safety records.",
      "Manufacturing Scalability & Quality": "Evaluates production capacity, yield rates, and quality management systems (e.g., ISO 13485) to meet global demand. Evidence includes manufacturing certifications, capacity expansions, and supply chain resilience.",
      "Data Integration & Connectivity": "Refers to interoperability with mobile apps, insulin pumps, and electronic health records via Bluetooth, NFC, or cloud. Strength shown by partnerships with digital health platforms and API availability."
    },
    "y": {
      "Reimbursement & Payer Coverage": "Indicates the extent to which insurers and national health systems cover the device, reducing patient out-of-pocket costs. Evidence includes reimbursement codes, coverage decisions, and payer contracts.",
      "Clinical Adoption & KOL Support": "Measures usage by endocrinologists, diabetes educators, and key opinion leaders in guidelines and publications. Strength shown by adoption rates, clinical guideline inclusion, and KOL endorsements.",
      "Global Distribution & Partnerships": "Assesses the breadth of distribution networks and strategic alliances with pharmacies, distributors, and telehealth providers. Evidence includes geographic reach, partnership announcements, and channel agreements.",
      "Financial Strength & Growth": "Evaluates revenue, profitability, and growth trajectory in the wearable glucometer segment. Strength indicated by sales figures, market share gains, and investment in R&D and expansion.",
      "Product Pipeline & Indication Expansion": "Covers development of next-generation sensors, expanded indications (e.g., prediabetes, type 2), and integration with closed-loop systems. Evidence includes pipeline announcements, clinical trials, and regulatory filings."
    }
  },
  "x_features": [
    "Sensor Accuracy & Reliability",
    "Wearability & User Experience",
    "Regulatory Clearances & Compliance",
    "Manufacturing Scalability & Quality",
    "Data Integration & Connectivity"
  ],
  "y_features": [
    "Reimbursement & Payer Coverage",
    "Clinical Adoption & KOL Support",
    "Global Distribution & Partnerships",
    "Financial Strength & Growth",
    "Product Pipeline & Indication Expansion"
  ],
