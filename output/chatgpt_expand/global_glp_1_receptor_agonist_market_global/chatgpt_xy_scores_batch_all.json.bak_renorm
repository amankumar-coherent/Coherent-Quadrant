{
  "industry_group": "Healthcare",
  "industry_category": "Pharmaceutical",
  "axis_x": "Therapeutic & Manufacturing Capability",
  "axis_y": "Commercial Reach & Pipeline Strategy",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the dual pillars of GLP-1 market success: robust therapeutic and manufacturing capabilities (X) and commercial execution and future growth potential (Y). They are specific to the pharmaceutical context, focusing on molecule portfolio, clinical differentiation, supply scale, regulatory track record, market access, brand trust, financials, pipeline, and partnerships.",
  "parameter_definitions": {
    "x": {
      "Product / Molecule Portfolio": "Breadth of approved GLP-1 RA products (e.g., semaglutide, liraglutide, tirzepatide) and formulations (oral, injectable). Strength shown by number of marketed products and diverse delivery options.",
      "Therapeutic Coverage & Differentiation": "Range of indications covered (T2D, obesity, cardiovascular risk) and unique mechanisms (dual/triple agonists). Strength shown by label expansions and clinical differentiation vs competitors.",
      "Innovation & Clinical R&D": "Investment in next-generation GLP-1s, novel delivery systems, and combination therapies. Strength shown by pipeline assets in Phase II/III and published trial results.",
      "Manufacturing & Supply Reliability": "Capacity for large-scale production of peptides, fill-finish capabilities, and supply chain resilience. Strength shown by manufacturing sites, capacity expansions, and ability to meet global demand.",
      "Regulatory & Quality Compliance": "Track record of FDA/EMA approvals, post-marketing safety, and GMP compliance. Strength shown by approval history, inspection outcomes, and absence of major recalls."
    },
    "y": {
      "Geographic Market Access": "Presence and reimbursement coverage in key markets (US, EU, Japan). Strength shown by approvals in multiple regions, pricing agreements, and formulary inclusion.",
      "Brand / HCP Reputation": "Perception among physicians and patients, driven by efficacy, safety, and real-world evidence. Strength shown by prescription trends, guideline inclusion, and KOL endorsements.",
      "Financial Performance": "Revenue growth, profitability, and market share in GLP-1 segment. Strength shown by quarterly sales, growth rates, and contribution to company revenue.",
      "Pipeline & Indication Roadmap": "Future catalysts including new indications (e.g., NASH, CKD) and combination trials. Strength shown by Phase III programs and expected regulatory filings.",
      "Partnerships & Business Expansion": "Strategic alliances, licensing deals, and M&A that expand capabilities or market reach. Strength shown by notable partnerships, acquisitions, and geographic expansion initiatives."
    }
  },
  "x_features": [
    "Product / Molecule Portfolio",
    "Therapeutic Coverage & Differentiation",
    "Innovation & Clinical R&D",
    "Manufacturing & Supply Reliability",
    "Regulatory & Quality Compliance"
  ],
  "y_features": [
    "Geographic Market Access",
    "Brand / HCP Reputation",
    "Financial Performance",
    "Pipeline & Indication Roadmap",
    "Partnerships & Business Expansion"
  ],
  "x_feature_weights": [
