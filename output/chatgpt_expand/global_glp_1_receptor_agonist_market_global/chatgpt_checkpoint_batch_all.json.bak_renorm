rivacy policy ][27] [ Terms of Use ][28] change [1]: javascript:void(0) [2]: javascript:void(0) [3]: javascript:void(0) [4]: javascript:void(0) [5]: javascript:void(0) [6]: javascript:void(0) [7]: /contact-us.html [8]: javascript:void(0) [9]: https://www.novonordisk.com.au/marie-krogh-prize.html [10]: /about/what-we-do.html [11]: https://performancemanager.successfactors.eu/sf/careers?company=novonordisk [12]: /careers/job-agent.html [13]: https://career2.successfactors.eu/career?career_company=novonordisk&lang=en_GB&company=novonor disk&site=&loginFlowRequired=true&career_job_req_id=1083&_s.crb=m7Q//WjXJ7txu/J6VxaXVNiDoAI%3D [14]: mailto:nzlccc@novonordisk.com [15]: /contact-us.html [16]: /content/dam/nncorp/nz/en/pdfs/SNYR_140220_Novo%20Nordisk%20Modern%20Slavery%20Statement%20201 9_Signed.pdf [17]: /contact-us.html [18]: /ethical-business.html [19]: /hcp-transfer-of-value---reporting.html [20]: https://www.linkedin.com/company/novo-nordisk [21]: https://www.youtube.com/user/novonordisk [22]: https://www.facebook.com/novonordisk [23]: https://twitter.com/novonordisk [24]: https://www.instagram.com/novonordisk [25]: /country-list.html [26]: /copyright.html [27]: /privacy-policy.html [28]: /cookie-policy.html", "discovery_snippets": [], "classify": {"summary": "Novo Nordisk New Zealand — channel participant (openai_web_search_discover). Verify: Novo Nordisk is the global leader in GLP-1 therapies, owning brands like semaglutide. | Global leader in GLP-1 therapies with presence in New Zealand | New Zealand | Auckland, New, Zealand", "role_description": "Brand"}}, "X Score": "54", "Y Score": "55", "Overall Score": "54", "Industry Category": "Healthcare / Pharmaceutical", "Quadrant": "Leaders"}, {"Company": "Sanofi India Ltd.", "Website": "https://www.sanofi.in", "Founded": "Not publicly disclosed", "Headquarters": "Maharashtra, India, Its", "Continent / Geography": "APAC(India)", "Operational Presence": "India", "Ownership": "Not publicly disclosed", "Employees": "Not