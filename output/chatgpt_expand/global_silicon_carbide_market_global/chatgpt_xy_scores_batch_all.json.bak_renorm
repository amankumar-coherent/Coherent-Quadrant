{
  "industry_group": "Chemical and Materials",
  "industry_category": "Advanced Materials",
  "axis_x": "Product Strength",
  "axis_y": "Business Strength",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters address the unique characteristics of the SiC market, where substrate quality, device reliability, and wafer size are critical product differentiators, while business strength hinges on customer wins, capacity expansion, and financial performance in a rapidly growing industry.",
  "parameter_definitions": {
    "x": {
      "Substrate & Epitaxy Quality": "Measures the crystalline quality, uniformity, and low defect density of SiC substrates and epitaxial layers, critical for high-performance power devices. Evidence includes defect density metrics, wafer bow, and surface roughness data from customer qualifications.",
      "Device Performance & Reliability": "Assesses the electrical characteristics (breakdown voltage, on-resistance, switching speed) and long-term reliability of SiC MOSFETs, diodes, and modules. Evidence includes datasheet parameters, qualification test results (e.g., HTGB, HTRB), and field failure rates.",
      "Wafer Size & Defect Density": "Evaluates the ability to produce larger diameter wafers (150mm, 200mm) with low defect density, directly impacting die cost and throughput. Evidence includes wafer diameter offerings, defect density maps, and transition roadmaps to 200mm.",
      "R&D and Patent Strength": "Captures investment in next-generation SiC technology (e.g., trench MOSFETs, superjunction) and intellectual property portfolio. Evidence includes R&D spending as % of revenue, patent counts, and technical publications.",
      "Manufacturing Yield & Scalability": "Reflects production efficiency, yield rates, and ability to scale output to meet demand. Evidence includes yield percentages, capacity utilization, and announced fab expansions or conversions."
    },
    "y": {
      "Market Share & Customer Base": "Measures the company's share of the global SiC market and the breadth/quality of its customer base, including automotive, industrial, and energy customers. Evidence includes market share estimates, design wins, and long-term supply agreements.",
      "Revenue Growth & Profitability": "Assesses financial performance through revenue growth, gross margin, and profitability in the SiC business segment. Evidence includes segment financials, margin trends, and return on invested capital.",
      "Capacity Expansion & Supply Chain": "Evaluates the ability to secure raw materials (e.g., high-purity silicon, graphite) and expand manufacturing capacity to meet demand. Evidence includes announced capacity expansions, vertical integration, and supply agreements.",
      "Geographic & Application Diversification": "Captures the spread of sales across regions and applications (EVs, renewables, industrial) to reduce dependence on any single market. Evidence includes revenue breakdown by geography and application.",
      "Strategic Partnerships & Alliances": "Reflects the strength of collaborations with key customers, suppliers, and technology partners to accelerate adoption and innovation. Evidence includes joint ventures, co-development agreements, and long-term contracts."
    }
  },
  "x_features": [
    "Substrate & Epitaxy Quality",
    "Device Performance & Reliability",
    "Wafer Size & Defect Density",
    "R&D and Patent Strength",
    "Manufacturing Yield & Scalability"
  ],
  "y_features": [
    "Market Share & Customer Base",
    "Revenue Growth & Profitability",
    "Capacity Expansion & Supply Chain",
    "Geographic & Application Diversification",
