  "parameter_definitions": {
    "x": {
      "Asset / Project Portfolio Breadth": "The range and scale of LNG production, liquefaction, and regasification assets a company operates globally, including the number of projects and total capacity.",
      "Operational Efficiency & Throughput": "How effectively a company utilizes its LNG facilities to maximize output relative to capacity, minimizing downtime and optimizing production rates.",
      "Reliability & Asset Performance": "The consistency and dependability of LNG plants in meeting production targets, with high utilization rates and low unplanned outages.",
      "Safety & Regulatory Compliance": "Adherence to international safety standards and environmental regulations across LNG operations, evidenced by low incident rates and full permits.",
      "Sustainability & Energy Transition": "Commitment to reducing carbon emissions and integrating cleaner technologies in LNG production, such as carbon capture and renewable energy use."
    },
    "y": {
      "Geographic & Corridor Reach": "The extent of a company's LNG supply and trading network across key global markets and shipping routes, enabling flexible delivery to diverse buyers.",
      "Offtake / Customer Contracts": "The portfolio of long-term and short-term sales agreements with buyers, indicating demand security and pricing terms.",
      "Financial Performance": "Profitability, revenue growth, and cash flow generation from LNG operations, reflecting overall business health and shareholder returns.",
      "Growth & Project Pipeline": "The number and scale of new LNG projects under development or planned, including expansions and greenfield ventures.",
      "Partnerships & Business Expansion": "Strategic alliances, joint ventures, and new market entries that enhance a company's LNG value chain and competitive position."
    }
  }
}