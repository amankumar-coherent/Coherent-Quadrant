{
  "industry_group": "Healthcare",
  "industry_category": "Pharmaceutical",
  "axis_x": "Product Strength",
  "axis_y": "Business Strength",
  "axis_definition_method": "llm",
  "axis_definition_reason": "These parameters capture the unique dynamics of the dry eye treatment market, where product differentiation hinges on molecule diversity, therapeutic coverage, and clinical innovation, while business strength depends on global access, specialist reputation, and strategic partnerships. They align with the fixed axes of Product Strength and Business Strength while being specific to ophthalmic pharmaceuticals.",
  "parameter_definitions": {
    "x": {
      "Product / Molecule Portfolio": "Breadth and depth of approved dry eye treatments, including prescription and OTC products across artificial tears, anti-inflammatories, immunomodulators, and secretagogues. Strength is shown by multiple approved products covering different severity levels and mechanisms.",
      "Therapeutic Coverage & Differentiation": "Ability to address diverse dry eye subtypes (aqueous-deficient, evaporative, mixed) and patient segments with differentiated efficacy, safety, or convenience. Evidence includes clinical data showing superiority over existing therapies and unique mechanisms of action.",
      "Innovation & Clinical R&D": "Investment in novel dry eye therapies such as new formulations, biologics, gene therapies, and devices, with a robust pipeline of Phase II/III candidates. Strength is indicated by high R&D spend, number of active trials, and recent approvals.",
      "Manufacturing & Supply Reliability": "Capacity to produce sterile ophthalmic products at scale with consistent quality and minimal supply disruptions. Evidence includes FDA inspection records, recall history, and ability to meet global demand.",
      "Regulatory & Quality Compliance": "Track record of obtaining and maintaining approvals from agencies like FDA, EMA, and PMDA for dry eye products. Strength is shown by clean regulatory histories, timely approvals, and compliance with cGMP standards."
    },
    "y": {
      "Geographic Market Access": "Extent of product availability and reimbursement across major markets (US, EU, Japan, China) and emerging regions. Strength is evidenced by number of countries with approved products, payer coverage, and local partnerships.",
      "Brand / HCP Reputation": "Recognition and trust among ophthalmologists, optometrists, and patients for dry eye treatments. Strong reputation is shown by market share, prescription volume, and positive sentiment in medical communities.",
      "Financial Performance": "Revenue growth, profitability, and financial stability from dry eye product sales. Evidence includes segment revenue, gross margins, and consistent earnings from ophthalmic franchises.",
      "Pipeline & Indication Roadmap": "Strategic plan for expanding dry eye indications, formulations, or delivery methods, with clear timelines and milestones. Strength is indicated by late-stage candidates and lifecycle management strategies.",
      "Partnerships & Business Expansion": "Collaborations with eye care specialists, distributors, and technology firms to enhance market reach and innovation. Evidence includes licensing deals, co-development agreements, and acquisitions in dry eye space."
    }
  },
  "x_features": [
    "Product / Molecule Portfolio",
    "Therapeutic Coverage & Differentiation",
    "Innovation & Clinical R&D",
    "Manufacturing & Supply Reliability",
    "Regulatory & Quality Compliance"
