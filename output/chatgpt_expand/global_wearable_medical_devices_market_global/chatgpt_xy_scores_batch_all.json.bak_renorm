  "parameter_definitions": {
    "x": {
      "Device Portfolio Breadth": "The range and variety of wearable medical devices offered, including different form factors (e.g., patches, watches) and monitoring capabilities (e.g., ECG, glucose), indicating the company's ability to serve diverse patient needs.",
      "Clinical Performance & Safety": "The accuracy, reliability, and safety of the devices in real-world clinical use, supported by clinical trials, real-world evidence, and low adverse event rates, demonstrating that the devices are effective and safe for patients.",
      "Innovation & R&D Capability": "The company's investment in research and development, including new sensor technologies, AI algorithms, and novel device designs, leading to differentiated products and a strong pipeline of next-generation wearables.",
      "Manufacturing & Quality Systems": "The efficiency and scalability of production processes, adherence to strict quality standards (e.g., ISO 13485), and the ability to maintain consistent product quality across large volumes, ensuring reliable supply.",
      "Regulatory & Quality Compliance": "The company's track record of obtaining and maintaining regulatory approvals (e.g., FDA, CE marking) and compliance with global medical device regulations, indicating the ability to bring products to market and avoid compliance issues."
    },
    "y": {
      "Geographic & Channel Reach": "The extent of the company's distribution network and market presence across different regions and sales channels (e.g., hospitals, retail, online), enabling broad patient access and market penetration.",
      "Brand Trust & Clinical Adoption": "The level of trust and acceptance among healthcare professionals and patients, reflected in clinical guidelines, physician recommendations, and patient satisfaction, driving adoption and loyalty.",
      "Financial Performance": "The company's revenue growth, profitability, and market share in the wearable medical devices market, indicating its commercial success and ability to sustain operations and invest in growth.",
      "Pipeline & Indication Expansion": "The breadth and progress of the company's product pipeline, including new devices and expansion into additional medical indications (e.g., cardiac, respiratory, metabolic), which can open new market opportunities.",
      "Partnerships & Business Expansion": "The company's strategic alliances with healthcare providers, tech companies, or distributors, as well as mergers and acquisitions, which can enhance capabilities, expand market reach, and accelerate growth."
    }
  }
}