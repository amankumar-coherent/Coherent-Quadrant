# =============================================================================
# Vendor Intelligence + Coherent Quadrant — copy to `.env` (never commit `.env`)
#
#   copy .env.example .env
#   # then paste at least one LLM API key
#
# Required for a quadrant run (scripts/run_quadrant_pipeline.py, any market):
#   DEEPSEEK_API_KEY  (or another provider below) -- X/Y parameters, definitions, scoring
#   GOOGLE_AI_MODE_ENABLED=true + Google Chrome installed -- discovery / market analysis
# =============================================================================

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------
USE_MOCK_DATA=false
MOCK_MODE=false

# -----------------------------------------------------------------------------
# LLM — pick ONE provider and paste its key
# -----------------------------------------------------------------------------
# DeepSeek paid (recommended official API):
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions

# Or OpenCode (free models):
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=PASTE_YOUR_OPENCODE_KEY
# OPENCODE_MODEL=deepseek-v4-flash-free
# Prefer nemotron if deepseek flash rejects response_format:
# OPENCODE_MODEL=nemotron-3-super-free

# Or Anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY
# COMPILER_MODEL=claude-haiku-4-5-20251001
# CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# MARKET_MAP_MODEL=claude-sonnet-4-6
# LLM_FALLBACK_TO_OPENCODE=true

# Or OpenRouter / Gemini / Groq:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional: ChatGPT expand uses DeepSeek via DEEPSEEK_* (mapped to OPENAI_* at runtime).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash
# SMART_CRAWL_USE_JSON_SCHEMA=false

# ChatGPT expand (scripts/run_chatgpt_expand.py) — separate from quadrant crawl:
# GOOGLE_AI_SCRAPER_ENABLED=true
# GOOGLE_AI_SCRAPER_URL=http://127.0.0.1:15561
# EXPAND_LANDSCAPE_MODE=vendors
# CHANNEL_PURITY_FILTER=false

# Safety cap used by some legacy paths — raise high for full pipeline+quadrant
MAX_LLM_CALLS_PER_RUN=500

# -----------------------------------------------------------------------------
# Main agent — quality landscape pipeline (run_pipeline.py)
# Discovers companies → SSC enrich → quality classify → CSV/XLSX
# -----------------------------------------------------------------------------
PIPELINE_PROFILE=quality
PIPELINE_USE_SSC=true
PIPELINE_RECALL_MODE=false
PIPELINE_MIN_EXPORT_CONFIDENCE=0.55
PIPELINE_ENUMERATE_PLAYERS=true
PIPELINE_DIRECTORY_MINING=true
PIPELINE_WIKIDATA=true
PIPELINE_PARTNER_MINING=true
PIPELINE_MARKET_ROLES=true
PIPELINE_STRICT_GEO=true
PIPELINE_SHUFFLE_EXPORT=false
PIPELINE_ENRICH_CONCURRENT=12
PIPELINE_CLASSIFY_CONCURRENT=12

# Regional defaults (non-global)
PIPELINE_DISCOVER_MAX=1000
PIPELINE_ENRICH_MAX=1000
PIPELINE_EXPORT_MIN_ROWS=0
# 0 = uncapped: every row clearing the relevance+quality gates is exported.
# With no cap, MIN_EXPORT_CONFIDENCE / MIN_QUALITY are the only scope guard - keep them high.
PIPELINE_EXPORT_MAX_ROWS=1000

# Global geography (--country global / --global) — higher caps
PIPELINE_GLOBAL_DISCOVER_MAX=1000
PIPELINE_GLOBAL_ENRICH_MAX=1000
PIPELINE_GLOBAL_EXPORT_MIN_ROWS=0
PIPELINE_GLOBAL_EXPORT_MAX_ROWS=1000
PIPELINE_GLOBAL_MIN_EXPORT_CONFIDENCE=0.50
PIPELINE_GLOBAL_MIN_QUALITY=0.48
PIPELINE_GLOBAL_VOLUME_PROMPT_COUNT=26
PHASE1_GLOBAL_SMOKE_MAX_PROMPTS=10
PHASE1_GLOBAL_DISCOVERY_PROMPTS=20

TARGET_UNIQUE_COMPANIES=280
DISCOVERY_YIELD_MIN_UNIQUE=200
TARGET_SOLID_COMPANIES=60
MAX_VALIDATION_ENTITIES=60
MIN_FINAL_COUNT=30
MAX_FINAL_COUNT=150
VOLUME_PROMPT_COUNT=36

# -----------------------------------------------------------------------------
# Coherent Quadrant agent (runs automatically after export when enabled)
# Writes: output/quadrant/<market-slug>_quadrant.json
# KB = pipeline evidence_snapshot only (no extra web search)
# -----------------------------------------------------------------------------
QUADRANT_ENABLED=true
# Graph = top 20 from the table; Company Details table = 250–300 after filter
QUADRANT_CHART_COMPANIES=20
QUADRANT_MAX_COMPANIES=20
QUADRANT_TABLE_COMPANIES=300
QUADRANT_BRAND_CONCURRENCY=6
QUADRANT_QA_BATCH_MODE=company
# Ignored — kept for backwards compatibility (always pipeline-KB only)
QUADRANT_WEB_SEARCH=false

# -----------------------------------------------------------------------------
# Google AI Overview collector (Chrome extension in extension/ + run_ai_bridge.py)
# Feeds cached AI Overview answers into the quadrant KB and discovery.
# A cache miss never blocks a run - it queues the question for the extension.
# See AI_OVERVIEW.md
# -----------------------------------------------------------------------------
AI_OVERVIEW_ENABLED=true
AI_OVERVIEW_DISCOVERY=true
# AI_OVERVIEW_CACHE_DIR=data/ai_overview_cache

# Google AI scraper — this project uses Chrome Profile 2 on :15561
# (other project keeps :15551)
GOOGLE_AI_SCRAPER_ENABLED=true
GOOGLE_AI_SCRAPER_URL=http://127.0.0.1:15561
GOOGLE_AI_SCRAPER_TIMEOUT=120

# --- Google AI Mode (udm=50) as a free LLM backend -------------------------
# ALWAYS ON by default, and the ONLY backend for the expand discovery steps
# (recall / discover / extract / verify / fill) — there is NO API fallback, so
# a hard failure stops the run rather than silently spending API credits.
# It retries internally first: a rate limit gets a long cool-off, a refusal
# gets an immediate reword, a bad reply gets a shorter-JSON retry.
# Requires `pip install patchright` and Google Chrome on the host.
# Scoring and the X/Y axis definitions are NOT affected — they stay on
# DeepSeek.
# Keep HEADLESS=false: a CAPTCHA can only be solved in a visible window.
# Run ONE market at a time — two processes on one IP is what triggers
# throttling. Set to false only if you deliberately want the API backend.
GOOGLE_AI_MODE_ENABLED=true
GOOGLE_AI_MODE_HEADLESS=false
GOOGLE_AI_MODE_BROWSER=chrome
GOOGLE_AI_MODE_QUERY_DELAY=10
GOOGLE_AI_MODE_PROFILE_DIR=data/ai_mode_chrome_profile
# Optional CAPTCHA-solver extension (e.g. captcha-raptor).
#
# Setup (verified working on this machine):
#   pip install patchright
#   python -m patchright install chromium
#   python -m vendor_intel.scraping.google_ai_mode install C:\path\to\captcha-raptor
#   python -m vendor_intel.scraping.google_ai_mode doctor     # proves it loaded
#
# `install` stages a COPY next to the profile so it survives a profile rebuild
# and the download folder can be deleted. Point it at the folder CONTAINING
# manifest.json; captcha-raptor keeps its own in extension/, auto-detected.
#
# This machine's Chrome is enterprise-managed, so --load-extension is silently
# ignored there. Staging any extension therefore switches to bundled Chromium,
# which loads it but gets CAPTCHA'd more often than real Chrome. Set
# GOOGLE_AI_MODE_FORCE_CHROMIUM=false to stay on real Chrome instead.
# An extension cannot clear the "Cannot contact reCAPTCHA" /sorry/ block at
# all — only pacing (GOOGLE_AI_MODE_QUERY_DELAY) prevents that.
# captcha-raptor is BUNDLED in extensions/captcha-raptor and loads automatically
# (no install step needed). Turn it off with:
# GOOGLE_AI_MODE_BUNDLED_EXTENSIONS=false
# Extra extensions (optional, ;-separated):
# GOOGLE_AI_MODE_EXTENSIONS=C:\path\to\captcha-raptor
# GOOGLE_AI_MODE_FORCE_CHROMIUM=true

FACT_ENRICH_LLM=true

# Found in (Company Details): auto City, Country via known map + Wikipedia
# FOUND_IN_CITY_COUNTRY=1
# FOUND_IN_WIKI_RESOLVE=1
# FOUND_IN_HQ_CACHE=data/hq_city_country_cache.json

# Drop wrong-industry / fake placeholders / R&D / regional dupes / acquired shells
# EXPAND_MARKET_GATE=1
# Config: config/expand_market_gates.yaml

# Score all ~40–45 exported vendors (slower / more LLM cost):
# QUADRANT_MAX_COMPANIES=45

# Optional CMI Next.js path override (frontend apps/web):
# VENDOR_INTEL_QUADRANT_DIR=./output/quadrant

# Feature-weight policy lives in config/quadrant_scoring_weights.yaml
# (set use_matrix_slot_weights: true there to match Vendor Evaluation Matrix Excel)

# -----------------------------------------------------------------------------
# Free search — DDGS → Bing HTML → SearXNG
# Docker: SEARXNG_BASE_URL is overridden to http://searxng:8080 by compose
# Local Python: http://127.0.0.1:8080 after `docker compose up -d searxng`
# -----------------------------------------------------------------------------
SEARCH_PRIMARY=duckduckgo
SEARCH_BACKUP=searxng
SEARCH_USE_FALLBACKS=true
SKIP_DDGS=false
SKIP_BING_HTML=false
PREFER_SEARXNG=false
DDGS_BACKENDS=duckduckgo,bing,brave,mojeek,google
SEARXNG_BASE_URL=http://127.0.0.1:8080
MIN_RESULTS_BEFORE_BACKUP=3
RESULTS_PER_QUERY=25
DDG_NEWS_API=false
DDG_WORKER_COUNT=0
# DISCOVERY_PARALLEL_BATCH=4
# DDGS_TIMEOUT=20
# DDG_REQUEST_DELAY=true
# DDG_REQUEST_DELAY_MIN=3
# DDG_REQUEST_DELAY_MAX=8

# Optional proxy pool (python scripts/check_proxies.py first):
# USE_PROXY_POOL=true
# DDGS_USE_PROXY_POOL=true
# DDGS_ALLOW_DIRECT=false
# PROXY_POOL_CACHE=output/proxy_pool_verified.json

# -----------------------------------------------------------------------------
# Enrichment / crawl
# -----------------------------------------------------------------------------
WIKIDATA_ENABLED=true
WEB_FETCH_ENABLED=true
SCRAPE_BACKEND=ddgs
SCRAPE_EXTRACT_FMT=text_markdown
SELENIUM_HEADLESS=true
SELENIUM_PAGE_LOAD_TIMEOUT=25
SELENIUM_IMPLICIT_WAIT=3
SELENIUM_SCROLL_PAUSE=0.6
# Windows host (local Python only):
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Docker image already sets Chrome at /usr/bin/google-chrome-stable

# -----------------------------------------------------------------------------
# Phase 3 validation
# -----------------------------------------------------------------------------
PHASE3_FAST_VALIDATION=true
PHASE3_PARALLEL_WORKERS=5
PHASE3_MAX_HITS_PER_QUERY=3
PHASE3_AGENTIC_VALIDATION=true
PHASE3_AGENTIC_MAX_ENTITIES=25
PHASE3_AGENTIC_BATCH_SIZE=8
PHASE3_AGENTIC_MAX_LLM_CALLS=3
PHASE3_ALWAYS_SCRAPE_REGISTRY=true

# -----------------------------------------------------------------------------
# CSV / market-query outputs
# -----------------------------------------------------------------------------
CSV_OUTPUT_ENABLED=true
CSV_OUTPUT_DIR=output
MARKET_QUERY_OUTPUT_DIR=output/demo

# -----------------------------------------------------------------------------
# Google Alerts / RSS (optional)
# -----------------------------------------------------------------------------
GOOGLE_ALERTS_ENABLED=false
# GOOGLE_ALERTS_RSS_URLS=
GOOGLE_ALERTS_PROFILE_PATH=data/chrome-profile
GOOGLE_ALERTS_HEADLESS=true
GOOGLE_ALERTS_STORE_PATH=data/alerts/articles.json
# RSS_FEED_URLS=

# -----------------------------------------------------------------------------
# Auth + Postgres (Streamlit UI login — not required for CLI pipeline)
# docker compose up -d postgres
# python scripts/init_auth_db.py
# -----------------------------------------------------------------------------
# Either set DATABASE_URL directly, or leave it unset and let these parts
# assemble the local DSN (see vendor_intel/auth/config.py).
# DATABASE_URL=
POSTGRES_USER=vendor
POSTGRES_PASSWORD=vendor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vendor_intel
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
AUTH_SESSION_HOURS=24
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_PER_WINDOW=3
AUTH_OTP_WINDOW_MINUTES=15
AUTH_ALLOWED_EMAIL_DOMAINS=coherentmarketinsights.com
AUTH_EMAIL_BACKEND=console
AUTH_APP_NAME=Vendor Intelligence
AUTH_SKIP_OTP=true
# AUTH_ADMIN_EMAILS=you@coherentmarketinsights.com
# AUTH_API_PORT=8001
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@coherentmarketinsights.com
# SMTP_USE_TLS=true
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Paid APIs — NOT required (leave empty)
# -----------------------------------------------------------------------------
# SERPAPI_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# NEWSAPI_API_KEY=
# GNEWS_API_KEY=
# CLEARBIT_API_KEY=
# FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Global Avocado Oil — Docker one-shot (after .env is filled)
# -----------------------------------------------------------------------------
#   docker compose up -d --build postgres searxng
#   docker compose run --rm --no-deps --entrypoint "" ^
#     -e SEARXNG_BASE_URL=http://host.docker.internal:8080 ^
#     app python run_pipeline.py --industry "Avocado Oil Market" --country global --global --live
#
# Or use the helper scripts:
#   .\scripts\run_global_avocado_oil.ps1
#   bash scripts/run_global_avocado_oil.sh
#
# Outputs:
#   output/pipeline/pipeline_avocado_oil_market_global.csv
#   output/pipeline/pipeline_avocado_oil_market_global.json
#   output/quadrant/avocado-oil-market_quadrant.json   ← Coherent Quadrant
# =============================================================================
