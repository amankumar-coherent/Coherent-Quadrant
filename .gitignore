# Only secrets and browser cookies are kept out of git. Everything else, including
# output/, is pushed (owner's choice, 2026-10-09). Keep the repository PRIVATE:
# output/ holds finished client reports.

# --- Secrets: never commit ---
.env
.streamlit/secrets.toml
# local login database (Streamlit auth)
data/auth_local.db
data/*.db

# --- Browser cookies and Google login sessions: never commit ---
# Every Google AI Mode browser profile (data/ai_mode_batch_<slot>_chromium, ..._extensions,
# ai_mode_chrome_profile*) and every archived/reset profile holds real cookies.
data/ai_mode_*/
data/_archived_profiles_*/
data/chrome-profile/
data/chrome-aio*/
data/chrome_profile*/

# --- Not source: reinstalled by setup.bat, regenerated on import, or tool caches ---
# (.venv is hundreds of MB of installed libraries; GitHub rejects files over 100 MB)
.venv/
.venv-crg/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
